---
import { Image } from 'astro:assets';
import {
	getCatalogCategories,
	kindLabels,
	statusLabels,
	type CatalogAction,
	type CatalogCategoryScope,
	type CatalogItem,
} from '../data/catalog';

interface Props {
	item: CatalogItem;
	compact?: boolean;
	headingLevel?: 'h2' | 'h3';
	categoryScope?: CatalogCategoryScope;
}

const { item, compact = false, headingLevel = 'h2', categoryScope = 'projects' } = Astro.props;
const categories = getCatalogCategories(item, categoryScope);
const Heading = headingLevel;
const searchText = [
	item.name,
	item.englishName,
	item.summary,
	kindLabels[item.kind],
	...item.capabilities,
	...categories.map((category) => category.name),
]
	.filter(Boolean)
	.join(' ');

const externalProps = (action: CatalogAction) =>
	action.external ? { target: '_blank' as const, rel: 'noopener noreferrer' } : {};
---

<article
	class:list={['catalog-card', `accent-${item.accent}`, { compact }]}
	data-catalog-card
	data-categories={categories.map((category) => category.id).join(' ')}
	data-search={searchText}
>
	<div class="card-topline" role="group" aria-label="项目类型与状态">
		{categories.map((category) => <span>{category.name}</span>)}
		<span>{kindLabels[item.kind]}</span>
		<span class="status"><i aria-hidden="true"></i>{statusLabels[item.status]}</span>
	</div>

	<div class="title-row">
		<div class="project-visual" aria-hidden="true">
			{item.icon ? (
				<Image src={item.icon} alt="" aria-hidden="true" widths={[56, 112]} sizes="56px" loading="lazy" decoding="async" />
			) : (
				<span>{item.kind === 'userscript' ? '//': '↗'}</span>
			)}
		</div>
		<div>
			<Heading>{item.name}</Heading>
			{item.englishName && <p class="english-name">{item.englishName}</p>}
		</div>
	</div>

	<p class="summary">{item.summary}</p>
	<ul class="capabilities" aria-label={`${item.name} 主要能力`}>
		{item.capabilities.map((capability) => <li>{capability}</li>)}
	</ul>

	<div class="card-actions">
		{item.detailsPath ? (
			<>
				<a class="card-primary" href={item.detailsPath}>查看详情 <span aria-hidden="true">→</span></a>
				<a class="card-secondary" href={item.primaryAction.href} {...externalProps(item.primaryAction)}>
					{item.kind === 'userscript' ? item.primaryAction.label : '下载'}
					{item.primaryAction.external && <><span aria-hidden="true">↗</span><span class="sr-only">（在新窗口打开）</span></>}
				</a>
			</>
		) : (
			<a class="card-primary" href={item.primaryAction.href} {...externalProps(item.primaryAction)}>
				{item.primaryAction.label} <span aria-hidden="true">{item.primaryAction.external ? '↗' : '→'}</span>
				{item.primaryAction.external && <span class="sr-only">（在新窗口打开）</span>}
			</a>
		)}
		{!item.detailsPath && item.secondaryAction && (
			<a class="card-text" href={item.secondaryAction.href} {...externalProps(item.secondaryAction)}>
				{item.secondaryAction.label} <span aria-hidden="true">↗</span><span class="sr-only">（在新窗口打开）</span>
			</a>
		)}
	</div>
</article>

<style>
	.catalog-card {
		--card-accent: var(--color-accent);
		position: relative;
		display: flex;
		min-width: 0;
		min-height: 100%;
		padding: 1.4rem;
		overflow: hidden;
		flex-direction: column;
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-small);
	}
	.catalog-card::before {
		position: absolute;
		top: 0;
		right: 1.25rem;
		left: 1.25rem;
		height: 3px;
		background: linear-gradient(90deg, var(--card-accent), transparent 80%);
		border-radius: 0 0 99px 99px;
		content: '';
	}
	.catalog-card:hover {
		border-color: color-mix(in srgb, var(--card-accent) 42%, var(--color-border));
		box-shadow: var(--shadow-medium);
		transform: translateY(-3px);
	}
	.accent-cyan { --card-accent: #238f91; }
	.accent-violet { --card-accent: #7b55d9; }
	.accent-amber { --card-accent: #c47a20; }
	.card-topline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.42rem;
		margin-bottom: 1rem;
	}
	.card-topline > span {
		padding: 0.18rem 0.48rem;
		background: var(--color-surface-muted);
		border-radius: 99px;
		color: var(--color-text-muted);
		font-size: var(--font-size-xs);
		font-weight: 700;
	}
	.card-topline .status {
		display: inline-flex;
		align-items: center;
		gap: 0.32rem;
		margin-left: auto;
		background: var(--color-success-soft);
		color: var(--color-success);
	}
	.status i {
		width: 0.38rem;
		height: 0.38rem;
		background: currentColor;
		border-radius: 50%;
	}
	.title-row {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: 0.9rem;
	}
	.title-row > div:last-child {
		min-width: 0;
	}
	.project-visual {
		display: grid;
		width: 3.5rem;
		height: 3.5rem;
		flex: 0 0 3.5rem;
		place-items: center;
		padding: 0.34rem;
		background: color-mix(in srgb, var(--card-accent) 10%, white);
		border: 1px solid color-mix(in srgb, var(--card-accent) 20%, var(--color-border));
		border-radius: 0.9rem;
		color: var(--card-accent);
		font-family: Consolas, monospace;
		font-size: 1.1rem;
		font-weight: 700;
	}
	.project-visual :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	h2,
	h3 {
		margin: 0;
		font-size: clamp(1.1875rem, 1.7vw, 1.375rem);
		overflow-wrap: anywhere;
	}
	.english-name {
		margin: 0.2rem 0 0;
		color: var(--color-text-soft);
		font-size: var(--font-size-xs);
		line-height: 1.35;
		overflow-wrap: anywhere;
	}
	.summary {
		flex: 1;
		margin-bottom: 1.1rem;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.65;
	}
	.capabilities {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 1.25rem;
		padding: 0;
		list-style: none;
	}
	.capabilities li {
		padding: 0.2rem 0.48rem;
		border: 1px solid var(--color-border);
		border-radius: 0.45rem;
		color: var(--color-text-muted);
		font-size: var(--font-size-xs);
	}
	.card-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}
	.card-actions a {
		display: inline-flex;
		min-height: 2.35rem;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		padding: 0.42rem 0.7rem;
		border-radius: 0.6rem;
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-decoration: none;
	}
	.card-primary {
		background: var(--color-text);
		color: #fff;
	}
	.card-primary:hover {
		background: var(--color-accent-hover);
		color: #fff;
	}
	.card-secondary {
		border: 1px solid var(--color-border-strong);
		color: var(--color-text);
	}
	.card-secondary:hover {
		border-color: var(--color-accent);
		color: var(--color-accent-hover);
	}
	.card-text {
		color: var(--color-text-muted);
	}
	.compact {
		padding: 1.2rem;
	}
	@media (max-width: 420px) {
		.catalog-card {
			padding: 1.15rem;
		}
		.card-topline .status {
			margin-left: 0;
		}
		.card-actions a {
			flex: 1 1 8rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.catalog-card:hover { transform: none; }
	}
</style>
