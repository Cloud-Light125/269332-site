---
import { Image } from 'astro:assets';
import siteIcon from '../assets/branding/site-icon.png';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header" data-site-header>
	<div class="header-inner">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<span class="brand-mark" aria-hidden="true"><Image src={siteIcon} alt="" widths={[32, 64]} sizes="32px" /></span>
			<span>{SITE_TITLE}</span>
		</a>

		<div class="nav-panel" id="site-navigation" data-nav-panel>
			<nav aria-label="主导航">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/projects/">项目</HeaderLink>
				<HeaderLink href="/tools/">游戏</HeaderLink>
				<HeaderLink href="/blog/">博客</HeaderLink>
				<HeaderLink href="/about/">关于</HeaderLink>
			</nav>
			<a class="mobile-github" href="https://github.com/yundan125" target="_blank" rel="noopener noreferrer">
				GitHub <span aria-hidden="true">↗</span><span class="sr-only">（在新窗口打开）</span>
			</a>
		</div>

		<div class="header-actions">
			<a class="github-link" href="https://github.com/yundan125" target="_blank" rel="noopener noreferrer">
				GitHub <span aria-hidden="true">↗</span><span class="sr-only">（在新窗口打开）</span>
			</a>
			<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-nav-toggle>
				<span class="sr-only">打开导航</span>
				<span aria-hidden="true"></span><span aria-hidden="true"></span>
			</button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector('[data-site-header]');
	const toggle = header?.querySelector('[data-nav-toggle]');
	const panel = header?.querySelector('[data-nav-panel]');

	if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
		const closeMenu = () => {
			toggle.setAttribute('aria-expanded', 'false');
			toggle.querySelector('.sr-only')!.textContent = '打开导航';
			panel.classList.remove('is-open');
		};

		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			toggle.setAttribute('aria-expanded', String(open));
			toggle.querySelector('.sr-only')!.textContent = open ? '关闭导航' : '打开导航';
			panel.classList.toggle('is-open', open);
		});

		panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
		window.addEventListener('resize', () => {
			if (window.innerWidth > 760) closeMenu();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		padding: 0 1rem;
		background: rgba(250, 251, 254, 0.86);
		border-bottom: 1px solid rgba(223, 228, 238, 0.82);
		backdrop-filter: blur(18px);
	}
	.header-inner {
		display: flex;
		width: min(var(--content-width), 100%);
		min-height: 4.6rem;
		align-items: center;
		gap: 1.25rem;
		margin: 0 auto;
	}
	.brand {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.65rem;
		color: var(--color-text);
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: 0.035em;
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		overflow: hidden;
		background: var(--color-surface-muted);
		border-radius: 0.65rem;
		box-shadow: 0 8px 18px rgba(87, 89, 214, 0.2);
	}
	.brand-mark :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
	.nav-panel {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}
	nav :global(a) {
		display: inline-flex;
		min-height: 2.5rem;
		align-items: center;
		padding: 0.45rem 0.78rem;
		border-radius: 0.65rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		font-weight: 600;
	}
	nav :global(a:hover) {
		background: var(--color-surface-muted);
		color: var(--color-text);
	}
	nav :global(a.active) {
		background: var(--color-accent-soft);
		color: var(--color-accent-hover);
	}
	.header-actions {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.55rem;
	}
	.github-link,
	.mobile-github {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.52rem 0.75rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.65rem;
		color: var(--color-text);
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
	}
	.github-link:hover,
	.mobile-github:hover {
		background: var(--color-surface);
		border-color: var(--color-accent);
		color: var(--color-accent-hover);
	}
	.mobile-github,
	.nav-toggle {
		display: none;
	}
	@media (max-width: 760px) {
		.site-header {
			padding: 0 0.75rem;
		}
		.header-inner {
			position: relative;
			min-height: 4.25rem;
			justify-content: space-between;
		}
		.github-link {
			display: none;
		}
		.nav-toggle {
			display: grid;
			width: 2.7rem;
			height: 2.7rem;
			place-content: center;
			gap: 0.34rem;
			padding: 0;
			background: var(--color-surface);
			border: 1px solid var(--color-border);
			border-radius: 0.7rem;
			cursor: pointer;
		}
		.nav-toggle > span[aria-hidden] {
			width: 1.1rem;
			height: 2px;
			background: var(--color-text);
			border-radius: 99px;
		}
		.nav-panel {
			position: absolute;
			top: calc(100% + 0.35rem);
			right: 0;
			left: 0;
			display: none;
			padding: 0.65rem;
			background: rgba(255, 255, 255, 0.98);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-medium);
			box-shadow: var(--shadow-medium);
		}
		.nav-panel.is-open {
			display: block;
		}
		nav {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.3rem;
		}
		nav :global(a) {
			justify-content: flex-start;
			padding: 0.6rem 0.7rem;
		}
		.mobile-github {
			display: flex;
			justify-content: center;
			margin-top: 0.5rem;
		}
	}
</style>
