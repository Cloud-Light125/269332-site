---
import CatalogCard from '../CatalogCard.astro';
import type { CatalogItem } from '../../data/catalog';

interface Props {
	id: string;
	label: string;
	title: string;
	description: string;
	items: CatalogItem[];
	allHref: string;
	allLabel: string;
}

const { id, label, title, description, items, allHref, allLabel } = Astro.props;
---

<section class="featured-section" aria-labelledby={id}>
	<header>
		<div>
			<p class="eyebrow">{label}</p>
			<h2 id={id}>{title}</h2>
			<p>{description}</p>
		</div>
		<a class="section-link" href={allHref}>{allLabel} <span aria-hidden="true">→</span></a>
	</header>
	<div class="catalog-grid">
		{items.map((item) => <CatalogCard item={item} headingLevel="h3" />)}
	</div>
</section>

<style>
	.featured-section { padding-top: var(--section-space); }
	header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2rem;
	}
	header > div { max-width: 43rem; }
	header p:last-child { margin: 0; color: var(--color-text-muted); }
	.section-link {
		flex: 0 0 auto;
		padding: 0.45rem 0;
		font-size: 0.86rem;
		font-weight: 700;
		text-decoration: none;
	}
	.catalog-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	@media (max-width: 940px) {
		.catalog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.catalog-grid > :global(:last-child:nth-child(odd)) { grid-column: 1 / -1; }
	}
	@media (max-width: 650px) {
		header { display: block; }
		.section-link { display: inline-block; margin-top: 1rem; }
		.catalog-grid { grid-template-columns: 1fr; }
		.catalog-grid > :global(:last-child:nth-child(odd)) { grid-column: auto; }
	}
</style>
