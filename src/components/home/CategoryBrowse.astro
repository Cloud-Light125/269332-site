---
import { Image } from 'astro:assets';
import { hasCatalogCategory, projectCategories, type CatalogItem } from '../../data/catalog';

interface Props { items: CatalogItem[]; }
const { items } = Astro.props;
const homeCategories = projectCategories.filter((category) => category.showOnHome);
---

<section class="category-section" aria-labelledby="category-title">
	<header>
		<p class="eyebrow">按类别浏览</p>
		<h2 id="category-title">按用途浏览</h2>
	</header>
	<div class="category-grid">
		{homeCategories.map((category) => {
			const count = items.filter((item) => hasCatalogCategory(item, category.id)).length;
			return (
				<a href={`/projects/?category=${category.id}`}>
					<span class="category-icon" aria-hidden="true">
						{category.icon && <Image src={category.icon} alt="" widths={[52, 104]} sizes="52px" loading="lazy" decoding="async" />}
					</span>
					<div><h3>{category.name}</h3><p>{category.description}</p></div>
					<small>{count} 个项目 <i aria-hidden="true">→</i></small>
				</a>
			);
		})}
	</div>
</section>

<style>
	.category-section { padding-top: var(--section-space); }
	header { max-width: 42rem; margin-bottom: 2rem; }
	.category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.category-grid a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1rem;
		padding: 1.35rem;
		background: rgba(255, 255, 255, 0.68);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-large);
		color: inherit;
		text-decoration: none;
	}
	.category-grid a:hover { background: var(--color-surface); border-color: var(--color-accent); box-shadow: var(--shadow-small); transform: translateY(-2px); }
	.category-icon {
		display: grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		padding: 0.2rem;
		overflow: hidden;
		background: var(--color-surface-muted);
		border-radius: 0.9rem;
	}
	.category-icon :global(img) { display: block; width: 100%; height: 100%; border-radius: 0.7rem; object-fit: contain; }
	h3 { margin: 0.1rem 0 0.35rem; font-size: 1.2rem; }
	p { margin: 0; color: var(--color-text-muted); font-size: 0.9375rem; line-height: 1.6; }
	small { grid-column: 2; color: var(--color-text-soft); font-size: var(--font-size-xs); }
	small i { margin-left: 0.25rem; color: var(--color-accent); font-style: normal; }
	@media (max-width: 900px) { .category-grid { grid-template-columns: 1fr; } }
	@media (prefers-reduced-motion: reduce) { .category-grid a:hover { transform: none; } }
</style>
