---
import { Image } from 'astro:assets';
import { kindLabels, type CatalogItem } from '../../data/catalog';

interface Props {
	items: CatalogItem[];
}

const { items } = Astro.props;
---

<section class="home-hero" aria-labelledby="home-title">
	<div class="hero-copy">
		<p class="eyebrow">CloudLight · 软件与工具</p>
		<h1 id="home-title">实用软件与工具，解决具体使用需求。</h1>
		<p class="hero-intro">
			集中整理 Windows 软件、游戏与直播工具、在线工具、浏览器脚本，以及相关的使用说明与开发记录。
		</p>
		<div class="hero-actions">
			<a class="button button-primary" href="/projects/">浏览项目 <span aria-hidden="true">→</span></a>
			<a class="button button-secondary" href="/blog/">查看博客</a>
		</div>
		<ul class="content-kinds" aria-label="网站内容类型">
			<li>Windows 工具</li><li>游戏与直播</li><li>在线工具</li><li>浏览器脚本</li>
		</ul>
	</div>

	<div class="hero-showcase" aria-label="推荐项目">
		<div class="showcase-heading">
			<div><span aria-hidden="true"></span> 推荐项目</div>
			<small>快速访问</small>
		</div>
		<div class="showcase-list">
			{items.map((item) => (
				<a
					class:list={['showcase-item', `accent-${item.accent}`]}
					href={item.detailsPath ?? item.primaryAction.href}
					target={!item.detailsPath && item.primaryAction.external ? '_blank' : undefined}
					rel={!item.detailsPath && item.primaryAction.external ? 'noopener noreferrer' : undefined}
				>
					<span class="showcase-icon" aria-hidden="true">
						{item.icon ? <Image src={item.icon} alt="" widths={[42, 84]} sizes="42px" /> : item.kind === 'userscript' ? '//' : '↗'}
					</span>
					<span class="showcase-copy">
						<small>{kindLabels[item.kind]}</small>
						<strong>{item.name}</strong>
						<span>{item.summary}</span>
					</span>
					<i aria-hidden="true">→</i>
				</a>
			))}
		</div>
		<div class="showcase-foot">项目页会按项目类型提供下载、在线使用或脚本安装入口。</div>
	</div>
</section>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(25rem, 0.95fr);
		align-items: center;
		gap: clamp(2.5rem, 7vw, 6.5rem);
		min-height: min(46rem, calc(100vh - 4.6rem));
		padding: clamp(4.5rem, 9vw, 8rem) 0;
	}
	.hero-copy { min-width: 0; }
	h1 {
		max-width: 11ch;
		margin-bottom: 1.4rem;
		font-size: var(--font-size-display);
		letter-spacing: -0.012em;
	}
	.hero-intro {
		max-width: 35rem;
		color: var(--color-text-muted);
		font-size: clamp(1.0625rem, 1.8vw, 1.1875rem);
		line-height: 1.68;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.content-kinds {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1rem;
		margin: 2rem 0 0;
		padding: 1.2rem 0 0;
		border-top: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		list-style: none;
	}
	.content-kinds li::before {
		margin-right: 0.45rem;
		color: var(--color-accent);
		content: '•';
	}
	.hero-showcase {
		min-width: 0;
		padding: 1rem;
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(203, 211, 225, 0.9);
		border-radius: var(--radius-xlarge);
		box-shadow: var(--shadow-medium);
		backdrop-filter: blur(12px);
	}
	.showcase-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.35rem 0.45rem 0.9rem;
		color: var(--color-text);
		font-size: var(--font-size-sm);
		font-weight: 700;
	}
	.showcase-heading div { display: flex; align-items: center; gap: 0.5rem; }
	.showcase-heading div span {
		width: 0.48rem;
		height: 0.48rem;
		background: #27a274;
		border-radius: 50%;
		box-shadow: 0 0 0 4px rgba(39, 162, 116, 0.12);
	}
	.showcase-heading small { color: var(--color-text-soft); font-weight: 400; }
	.showcase-list { display: grid; gap: 0.65rem; }
	.showcase-item {
		--item-accent: var(--color-accent);
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.85rem;
		padding: 0.85rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		color: inherit;
		text-decoration: none;
	}
	.showcase-item:hover {
		border-color: color-mix(in srgb, var(--item-accent) 45%, var(--color-border));
		box-shadow: var(--shadow-small);
		transform: translateX(3px);
	}
	.showcase-item.accent-cyan { --item-accent: #238f91; }
	.showcase-item.accent-violet { --item-accent: #7b55d9; }
	.showcase-item.accent-amber { --item-accent: #c47a20; }
	.showcase-icon {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		padding: 0.28rem;
		background: color-mix(in srgb, var(--item-accent) 10%, white);
		border-radius: 0.75rem;
		color: var(--item-accent);
		font-family: Consolas, monospace;
		font-weight: 700;
	}
	.showcase-icon :global(img) { width: 100%; height: 100%; object-fit: contain; }
	.showcase-copy { display: grid; min-width: 0; }
	.showcase-copy small { color: var(--item-accent); font-size: var(--font-size-xs); font-weight: 700; }
	.showcase-copy strong { color: var(--color-text); font-size: var(--font-size-md); line-height: 1.35; }
	.showcase-copy > span { margin-top: 0.18rem; color: var(--color-text-muted); font-size: var(--font-size-sm); line-height: 1.5; }
	.showcase-item > i { color: var(--color-text-soft); font-style: normal; }
	.showcase-foot { padding: 0.9rem 0.45rem 0.2rem; color: var(--color-text-soft); font-size: var(--font-size-xs); }
	@media (max-width: 920px) {
		.home-hero { grid-template-columns: 1fr; min-height: 0; }
		.hero-copy { max-width: 45rem; }
		.hero-showcase { width: min(38rem, 100%); }
	}
	@media (max-width: 520px) {
		.home-hero { padding-top: 3.75rem; }
		h1 { font-size: clamp(2.1rem, 10.5vw, 2.5rem); }
		.hero-actions .button { flex: 1 1 9rem; }
		.showcase-copy > span { display: none; }
		.showcase-item { padding: 0.75rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.showcase-item:hover { transform: none; }
	}
</style>
