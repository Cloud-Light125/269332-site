---
import CatalogCard from '../../components/CatalogCard.astro';
import { catalogItems, gameTools, hasCatalogCategory } from '../../data/catalog';
import BaseLayout from '../../layouts/BaseLayout.astro';

const gameItems = catalogItems.filter((item) => hasCatalogCategory(item, 'games'));
const overwatchWatcher = gameItems.find((item) => item.id === 'cloudlight-overwatch-youtube-watcher')!;
---

<BaseLayout
	title="游戏工具 · CloudLight"
	description="使用 Steam 游玩时光全景图、守望先锋看图猜英雄、CloudLight Blizzard 和直播观看辅助工具。"
>
	<main class="tools-page">
		<header class="tools-hero">
			<div>
				<p class="eyebrow">游戏</p>
				<h1>游戏数据、互动与直播工具</h1>
				<p>包含 Steam 游玩数据可视化、守望先锋互动工具，以及 Battle.net 多账号、国服 / 国际服本地切换、直播观看和掉宝任务辅助程序。</p>
				<div class="hero-actions">
					<a class="button button-primary" href={gameTools[0].primaryAction.href} target="_blank" rel="noopener noreferrer">生成 Steam 全景图 <span aria-hidden="true">↗</span><span class="sr-only">（在新窗口打开）</span></a>
					<a class="button button-secondary" href={overwatchWatcher.detailsPath}>查看直播助手</a>
				</div>
			</div>
			<div class="hero-mark" aria-hidden="true">
				<div><span>PLAY</span><strong>{String(gameItems.length).padStart(2, '0')}</strong></div>
				<p>Steam<br />Overwatch<br />Battle.net</p>
				<small>网页工具 · Windows 助手</small>
			</div>
		</header>

		<section class="tool-list" aria-labelledby="tool-list-title">
			<header><p class="eyebrow">全部工具</p><h2 id="tool-list-title">选择工具</h2></header>
			<div class="catalog-grid">{gameItems.map((tool) => <CatalogCard item={tool} headingLevel="h3" />)}</div>
		</section>

		<aside class="copyright-note" aria-label="游戏相关商标与非官方说明">
			<p>《守望先锋》及相关角色、美术素材版权归 Blizzard Entertainment 所有；相关工具与 Blizzard Entertainment 无官方关联。</p>
			<p>Steam 是 Valve Corporation 的商标；Steam 数据工具为独立项目，仅使用账号公开提供的游玩时长信息。</p>
		</aside>
	</main>
</BaseLayout>

<style>
	.tools-page { width: min(var(--content-width), calc(100% - 2rem)); max-width: none; }
	.tools-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.42fr);
		align-items: center;
		gap: clamp(2rem, 7vw, 6rem);
		padding-bottom: clamp(3.5rem, 7vw, 6rem);
	}
	.tools-hero > div:first-child { max-width: 49rem; }
	.tools-hero h1 { margin-bottom: 1.15rem; font-size: var(--font-size-page-title); }
	.tools-hero > div:first-child > p:last-of-type { color: var(--color-text-muted); font-size: 1.06rem; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.8rem; }
	.hero-mark { display: flex; min-height: 19rem; padding: 1.5rem; flex-direction: column; justify-content: space-between; background: linear-gradient(145deg, #1c2335, #252f46); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-xlarge); box-shadow: var(--shadow-medium); color: #fff; }
	.hero-mark div { display: flex; justify-content: space-between; color: #aeb5ff; font-size: var(--font-size-xs); font-weight: 700; letter-spacing: 0.1em; }
	.hero-mark div strong { color: #fff; font-size: 1.6rem; line-height: 1; }
	.hero-mark p { margin: 0; color: #fff; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.015em; }
	.hero-mark small { color: #9ca7bb; font-size: var(--font-size-xs); }
	.tool-list { padding-top: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--color-border); }
	.tool-list > header { margin-bottom: 1.75rem; }
	.catalog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.copyright-note { margin-top: 2rem; padding: 1.1rem 1.2rem; background: rgba(238, 241, 247, 0.72); border: 1px solid var(--color-border); border-radius: var(--radius-medium); color: var(--color-text-muted); font-size: var(--font-size-sm); }
	.copyright-note p { margin: 0; }
	.copyright-note p + p { margin-top: 0.5rem; }
	@media (max-width: 980px) { .catalog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .catalog-grid > :global(:last-child:nth-child(odd)) { grid-column: 1 / -1; } }
	@media (max-width: 820px) { .tools-hero { grid-template-columns: 1fr; } .hero-mark { display: none; } }
	@media (max-width: 700px) { .tools-page { width: min(var(--content-width), calc(100% - 1.5rem)); } .catalog-grid { grid-template-columns: 1fr; } .catalog-grid > :global(:last-child:nth-child(odd)) { grid-column: auto; } .hero-actions .button { flex: 1 1 12rem; } }
</style>
