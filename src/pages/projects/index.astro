---
import CatalogCard from '../../components/CatalogCard.astro';
import { hasCatalogCategory, projectCategories, projects } from '../../data/catalog';
import BaseLayout from '../../layouts/BaseLayout.astro';

const filters = projectCategories
	.map((category) => ({ ...category, count: projects.filter((project) => hasCatalogCategory(project, category.id)).length }))
	.filter((category) => category.count > 0);
---

<BaseLayout
	title="项目 · CloudLight"
	description="浏览 CloudLight 的 Windows 工具、游戏与直播工具和浏览器脚本，按类别或关键词查找项目，并查看功能、截图与获取入口。"
>
	<main class="projects-page">
		<header class="page-hero">
			<div>
				<p class="eyebrow">项目</p>
				<h1>按用途浏览工具</h1>
				<p>包含可下载的 Windows 软件、在线工具与浏览器脚本；每个项目页会按实际情况介绍主要功能、界面截图、使用说明和下载或安装入口。</p>
			</div>
			<div class="project-count"><strong>{projects.length}</strong><span>个软件与脚本项目</span></div>
		</header>

		<div class="catalog-controls">
			<div class="filter-bar" role="group" aria-label="按类别筛选项目">
				<button type="button" data-filter="all" aria-pressed="true">全部 <span>{projects.length}</span></button>
				{filters.map((filter) => (
					<button type="button" data-filter={filter.id} aria-pressed="false">{filter.name} <span>{filter.count}</span></button>
				))}
			</div>
			<label class="search-field">
				<span>搜索项目</span>
				<input
					id="project-search"
					data-project-search
					type="search"
					placeholder="名称、功能或关键词"
					autocomplete="off"
					spellcheck="false"
					aria-controls="project-grid"
				/>
			</label>
		</div>
		<p class="filter-status" data-filter-status aria-live="polite">共 {projects.length} 个软件与脚本项目</p>

		<section id="project-grid" class="catalog-grid" aria-label="项目列表" data-project-grid>
			{projects.map((project) => <CatalogCard item={project} />)}
		</section>
		<p class="empty-state" data-empty-state hidden>没有匹配的项目，请换一个关键词或清除筛选。</p>
	</main>

	<script>
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
		const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-catalog-card]'));
		const status = document.querySelector<HTMLElement>('[data-filter-status]');
		const empty = document.querySelector<HTMLElement>('[data-empty-state]');
		const search = document.querySelector<HTMLInputElement>('[data-project-search]');
		let activeFilter = 'all';

		const normalize = (value: string) => value.toLocaleLowerCase().replace(/\s+/g, '').trim();

		const applyFilter = (filter: string, query = '', updateUrl = true) => {
			activeFilter = filter;
			const normalizedQuery = normalize(query);
			let visible = 0;
			cards.forEach((card) => {
				const matchesCategory = filter === 'all' || (card.dataset.categories?.split(' ').includes(filter) ?? false);
				const matchesSearch = !normalizedQuery || normalize(card.dataset.search ?? '').includes(normalizedQuery);
				const show = matchesCategory && matchesSearch;
				card.hidden = !show;
				if (show) visible += 1;
			});
			buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)));
			if (status) status.textContent = normalizedQuery ? `找到 ${visible} 个软件与脚本项目` : filter === 'all' ? `共 ${visible} 个软件与脚本项目` : `当前分类显示 ${visible} 个软件与脚本项目`;
			if (empty) empty.hidden = visible > 0;

			if (updateUrl) {
				const url = new URL(window.location.href);
				if (filter === 'all') url.searchParams.delete('category');
				else url.searchParams.set('category', filter);
				if (normalizedQuery) url.searchParams.set('q', query.trim());
				else url.searchParams.delete('q');
				window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
			}
		};

		buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all', search?.value ?? '')));
		search?.addEventListener('input', () => applyFilter(activeFilter, search.value));
		const params = new URL(window.location.href).searchParams;
		const requested = params.get('category') ?? 'all';
		const requestedQuery = params.get('q') ?? '';
		if (search) search.value = requestedQuery;
		applyFilter(buttons.some((button) => button.dataset.filter === requested) ? requested : 'all', requestedQuery, false);
	</script>
</BaseLayout>

<style>
	.projects-page { width: min(var(--content-width), calc(100% - 2rem)); max-width: none; }
	.page-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 2rem;
		margin-bottom: 2rem;
		padding-bottom: clamp(2rem, 5vw, 3.25rem);
		border-bottom: 1px solid var(--color-border);
	}
	.page-hero > div:first-child { max-width: 48rem; }
	.page-hero h1 { margin-bottom: 1rem; font-size: var(--font-size-page-title); }
	.page-hero p:last-child { margin: 0; color: var(--color-text-muted); font-size: 1.03rem; }
	.project-count { display: grid; min-width: 8.5rem; padding: 1rem 1.15rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-medium); box-shadow: var(--shadow-small); text-align: center; }
	.project-count strong { font-size: 2rem; line-height: 1; }
	.project-count span { margin-top: 0.35rem; color: var(--color-text-muted); font-size: var(--font-size-sm); }
	.catalog-controls { display: grid; grid-template-columns: minmax(0, 1fr) minmax(17rem, 25rem); align-items: end; gap: 1rem 1.5rem; margin-bottom: 0.8rem; }
	.filter-bar { display: flex; flex-wrap: wrap; gap: 0.55rem; }
	.filter-bar button {
		display: inline-flex;
		min-height: 2.65rem;
		align-items: center;
		gap: 0.48rem;
		padding: 0.48rem 0.75rem;
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid var(--color-border);
		border-radius: 0.7rem;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		font-weight: 700;
		cursor: pointer;
	}
	.filter-bar button:hover { border-color: var(--color-accent); color: var(--color-text); }
	.filter-bar button[aria-pressed="true"] { background: var(--color-text); border-color: var(--color-text); color: #fff; }
	.filter-bar span { display: grid; min-width: 1.25rem; height: 1.25rem; place-items: center; padding: 0 0.25rem; background: rgba(128, 136, 158, 0.12); border-radius: 99px; font-size: var(--font-size-xs); }
	.filter-bar button[aria-pressed="true"] span { background: rgba(255, 255, 255, 0.15); }
	.search-field { display: grid; gap: 0.35rem; color: var(--color-text-muted); font-size: var(--font-size-sm); font-weight: 700; }
	.search-field input { width: 100%; min-height: 2.65rem; padding: 0.48rem 0.75rem; background: rgba(255, 255, 255, 0.82); border: 1px solid var(--color-border); border-radius: 0.7rem; color: var(--color-text); font-size: var(--font-size-md); font-weight: 400; }
	.search-field input::placeholder { color: var(--color-text-soft); }
	.search-field input:hover { border-color: var(--color-border-strong); }
	.filter-status { min-height: 1.4rem; margin: 0 0 1.2rem; color: var(--color-text-soft); font-size: var(--font-size-sm); }
	.catalog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.catalog-grid > :global([hidden]) { display: none; }
	.empty-state { padding: 3rem 1rem; background: var(--color-surface); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-large); color: var(--color-text-muted); text-align: center; }
	@media (max-width: 980px) { .catalog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 700px) {
		.projects-page { width: min(var(--content-width), calc(100% - 1.5rem)); }
		.page-hero { grid-template-columns: 1fr; }
		.project-count { display: flex; width: fit-content; align-items: baseline; gap: 0.5rem; text-align: left; }
		.project-count strong { font-size: 1.4rem; }
		.catalog-grid { grid-template-columns: 1fr; }
		.catalog-controls { grid-template-columns: 1fr; }
		.filter-bar { flex-wrap: nowrap; margin-right: -0.75rem; padding-right: 0.75rem; overflow-x: auto; scrollbar-width: thin; }
		.filter-bar button { flex: 0 0 auto; }
	}
</style>
