---
import CatalogCard from '../../components/CatalogCard.astro';
import { projects } from '../../data/catalog';
import BaseLayout from '../../layouts/BaseLayout.astro';

const gridBalanceClass =
	projects.length > 3 && projects.length % 3 === 1
		? 'remainder-one'
		: projects.length % 3 === 2
			? 'remainder-two'
			: undefined;
---

<BaseLayout
	title="项目 · CloudLight"
	description="查看 CloudLight 收录的 Windows 自动化工具、系统工具、源码补丁、下载入口和详细使用说明。"
>
	<main class="catalog-page">
		<header>
			<div>
				<p class="eyebrow">项目</p>
				<h1>项目与开发实践</h1>
				<p>查看项目用途、当前状态、下载入口和详细使用说明。</p>
			</div>
			<p class="count"><strong>{projects.length}</strong> 个项目</p>
		</header>
		<section class:list={['catalog-grid', gridBalanceClass]} aria-label="项目列表">
			{projects.map((project) => <CatalogCard item={project} />)}
		</section>
	</main>
</BaseLayout>

<style>
	.catalog-page {
		width: min(var(--content-width), calc(100% - 2rem));
		max-width: none;
	}
	header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
	}
	header h1 {
		font-size: clamp(2.25rem, 6vw, 3.75rem);
	}
	header div > p:last-child,
	.count {
		margin-bottom: 0;
		color: var(--color-text-muted);
	}
	.count {
		flex: 0 0 auto;
		font-size: 0.82rem;
	}
	.count strong {
		color: var(--color-text);
		font-size: 1.25rem;
	}
	.catalog-grid {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 1rem;
	}
	.catalog-grid > :global(.catalog-card) {
		grid-column: span 2;
	}
	.catalog-grid.remainder-two > :global(.catalog-card:nth-last-child(-n + 2)),
	.catalog-grid.remainder-one > :global(.catalog-card:nth-last-child(-n + 4)) {
		grid-column: span 3;
	}
	@media (max-width: 980px) {
		.catalog-grid > :global(.catalog-card),
		.catalog-grid.remainder-two > :global(.catalog-card:nth-last-child(-n + 2)),
		.catalog-grid.remainder-one > :global(.catalog-card:nth-last-child(-n + 4)) {
			grid-column: span 3;
		}
		.catalog-grid > :global(.catalog-card:last-child:nth-child(odd)) {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 720px) {
		.catalog-page {
			width: min(var(--content-width), calc(100% - 1.5rem));
		}
		header {
			display: block;
		}
		.count {
			margin-top: 1rem;
		}
		.catalog-grid {
			grid-template-columns: 1fr;
		}
		.catalog-grid > :global(.catalog-card),
		.catalog-grid.remainder-two > :global(.catalog-card:nth-last-child(-n + 2)),
		.catalog-grid.remainder-one > :global(.catalog-card:nth-last-child(-n + 4)),
		.catalog-grid > :global(.catalog-card:last-child:nth-child(odd)) {
			grid-column: auto;
		}
	}
</style>
