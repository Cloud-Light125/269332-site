.legend{display:flex;flex-wrap:wrap;gap:12px;margin-left:auto;color:var(--muted);font-size:11px}.legend-item{display:inline-flex;align-items:center;gap:6px}.legend-item::before{content:"";width:22px;border-top:3px solid var(--winner)}.legend-item.loser::before{border-color:var(--loser);border-top-style:dashed}
