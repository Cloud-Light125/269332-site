:root,
html[data-theme="light"] {
  color-scheme:light;
  --color-background:#f7f9fc;
  --color-surface:#ffffff;
  --color-surface-muted:#eef3f8;
  --color-text:#18202b;
  --color-text-muted:#5b6878;
  --color-border:#dce3eb;
  --color-accent:#245da8;
  --color-accent-hover:#19477f;
  --color-accent-soft:#e7f0fb;
  --radius-small:.55rem;
  --radius-medium:.9rem;
  --radius-large:1.35rem;
  --shadow-small:0 6px 18px rgba(24,32,43,.06);
  --shadow-medium:0 16px 40px rgba(24,32,43,.09);
  --content-width:1120px;
  --bg:var(--color-background);
  --panel:var(--color-surface);
  --panel-2:var(--color-surface-muted);
  --panel-3:#e7edf4;
  --card:var(--color-surface);
  --text:var(--color-text);
  --muted:var(--color-text-muted);
  --border:var(--color-border);
  --line:#91a0b1;
  --orange:#8a4b0f;
  --orange-soft:#fff7e8;
  --blue:var(--color-accent);
  --blue-soft:var(--color-accent-soft);
  --winner:#226b46;
  --winner-soft:#e8f5ee;
  --loser:#a65d0a;
  --loser-soft:#fff3e4;
  --qualified:#11665f;
  --qualified-soft:#e4f4f2;
  --danger:#b42318;
  --danger-soft:#feeceb;
  --shadow:var(--shadow-small);
  --radius:var(--radius-medium);
}
html {background:var(--color-background);scroll-behavior:smooth}
html,
body {
  min-width:0;
  color:var(--color-text);
  font-family:"Atkinson Hyperlegible","Noto Sans SC","Microsoft YaHei","PingFang SC",system-ui,sans-serif;
  background:radial-gradient(circle at 8% 0%,rgba(36,93,168,.1),transparent 28rem),linear-gradient(180deg,#fbfcfe 0,var(--color-background) 36rem);
}
body {overflow-x:hidden;font-size:17px;line-height:1.65}
a {color:var(--color-accent);text-underline-offset:.18em}
a:hover {color:var(--color-accent-hover)}
.skip-link {position:fixed;top:.75rem;left:.75rem;z-index:300;padding:.65rem .85rem;border-radius:var(--radius-small);background:var(--color-text);color:#fff;font-weight:700;transform:translateY(-160%)}
.skip-link:focus {color:#fff;transform:translateY(0)}
.global-header {position:sticky;top:0;z-index:80;padding:0 1rem;background:rgba(248,250,252,.88);border-bottom:1px solid rgba(220,227,235,.85);backdrop-filter:blur(16px)}
