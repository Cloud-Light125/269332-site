function deepClone(value){
  return typeof structuredClone === 'function' ? structuredClone(value) : JSON.parse(JSON.stringify(value));
}

function createDefaultState(){
  return {
    schemaVersion: SCHEMA_VERSION,
    config: deepClone(DEFAULT_CONFIG),
    predictions: {},
    ui: deepClone(DEFAULT_UI),
    updatedAt: new Date().toISOString()
  };
}

function normalizeLoadedState(raw){
  if(!raw || typeof raw !== 'object') return createDefaultState();
  if(raw.schemaVersion !== SCHEMA_VERSION || !raw.config) return createDefaultState();
  try{
    validateConfig(raw.config);
  }catch{
    return createDefaultState();
  }
  return {
    schemaVersion: SCHEMA_VERSION,
    config: deepClone(raw.config),
    predictions: raw.predictions && typeof raw.predictions === 'object' ? deepClone(raw.predictions) : {},
    ui: {...DEFAULT_UI, ...(raw.ui || {})},
    updatedAt: typeof raw.updatedAt === 'string' ? raw.updatedAt : new Date().toISOString()
  };
}

function loadState(){
  try{
    const raw = JSON.parse(localStorage.getItem(STORAGE_KEY));
    return normalizeLoadedState(raw);
  }catch{
    return createDefaultState();
  }
}

function saveState(showMessage=false){
  state.updatedAt = new Date().toISOString();
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    if(showMessage) showToast('当前状态已保存');
  }catch(error){
    if(showMessage) showToast('浏览器禁止本地存储，状态仅保留在当前页面');
  }
}

function pushHistory(){
  historyStack.push(JSON.stringify(state));
  if(historyStack.length > MAX_HISTORY) historyStack.shift();
  updateUndoButton();
}

function undoLastAction(){
  const snapshot = historyStack.pop();
  if(!snapshot){ showToast('没有可撤销的操作'); return; }
  state = normalizeLoadedState(JSON.parse(snapshot));
  saveState();
  renderTournament();
  showToast('已撤销上一次操作');
}

function updateUndoButton(){
  undoButton.disabled = historyStack.length === 0;
}

function getGroupMap(config=state.config){
  return Object.fromEntries(config.groups.map(group => [group.id, group]));
}
function getTeamMap(config=state.config){
  return Object.fromEntries(config.teams.map(team => [team.id, team]));
}
function getMatchMap(config=state.config){
  return Object.fromEntries(config.matches.map(match => [match.id, match]));
}

function escapeHtml(value){
  return String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
}
function escapeAttribute(value){ return escapeHtml(value).replace(/`/g,'&#96;'); }
function clamp(value,min,max){ return Math.min(max,Math.max(min,value)); }
function initials(name){
  const parts=String(name||'?').trim().split(/\s+/).filter(Boolean);
  return (parts.length>1 ? parts.slice(0,2).map(x=>x[0]).join('') : (parts[0]||'?').slice(0,2)).toUpperCase();
}

function sourceDescription(slot){
  if(slot.type === 'team') return '';
  const source = getMatchMap()[slot.matchId];
  if(!source) return 'Invalid source';
  return `${slot.type === 'winner' ? 'Winner of' : 'Loser of'} ${source.label}`;
}

function validateConfig(config){
  if(!config || typeof config !== 'object') throw new Error('config 必须是对象');
  if(!Array.isArray(config.groups) || config.groups.length === 0) throw new Error('groups 必须是非空数组');
  if(!Array.isArray(config.teams) || config.teams.length === 0) throw new Error('teams 必须是非空数组');
  if(!Array.isArray(config.matches) || config.matches.length === 0) throw new Error('matches 必须是非空数组');
  const groupIds = new Set();
  for(const group of config.groups){
    if(!group.id || groupIds.has(group.id)) throw new Error('小组 ID 缺失或重复');
    groupIds.add(group.id);
    if(!group.roundNames || typeof group.roundNames !== 'object') throw new Error(`小组 ${group.id} 缺少 roundNames`);
  }
  const teamIds = new Set();
  for(const team of config.teams){
    if(!team.id || teamIds.has(team.id)) throw new Error('队伍 ID 缺失或重复');
    if(!groupIds.has(team.groupId)) throw new Error(`队伍 ${team.id} 的 groupId 无效`);
    teamIds.add(team.id);
  }
  const matchIds = new Set();
  for(const match of config.matches){
    if(!match.id || matchIds.has(match.id)) throw new Error('比赛 ID 缺失或重复');
    if(!groupIds.has(match.groupId)) throw new Error(`比赛 ${match.id} 的 groupId 无效`);
    if(!['match','qualified'].includes(match.kind)) throw new Error(`比赛 ${match.id} 的 kind 无效`);
    if(!Array.isArray(match.slots) || match.slots.length !== (match.kind === 'qualified' ? 1 : 2)) throw new Error(`比赛 ${match.id} 的 slots 数量无效`);
    if(match.kind === 'match' && ![1,3,5].includes(Number(match.bestOf))) throw new Error(`比赛 ${match.id} 的 BO 必须为 1、3 或 5`);
    matchIds.add(match.id);
  }
  for(const match of config.matches){
    for(const slot of match.slots){
      if(slot.type === 'team'){
        if(!teamIds.has(slot.teamId)) throw new Error(`比赛 ${match.id} 引用了不存在的队伍 ${slot.teamId}`);
      }else if(slot.type === 'winner' || slot.type === 'loser'){
        if(!matchIds.has(slot.matchId)) throw new Error(`比赛 ${match.id} 引用了不存在的比赛 ${slot.matchId}`);
      }else throw new Error(`比赛 ${match.id} 包含无效 slot 类型`);
    }
    for(const edge of [match.winnerTo, match.loserTo]){
      if(edge && !matchIds.has(edge.matchId)) throw new Error(`比赛 ${match.id} 的晋级目标不存在`);
    }
  }
  // Dependency-cycle validation.
  const graph = new Map(config.matches.map(match => [match.id, match.slots.filter(s=>s.type!=='team').map(s=>s.matchId)]));
  const visiting = new Set(), visited = new Set();
  function dfs(id){
    if(visiting.has(id)) throw new Error('比赛来源关系存在循环');
    if(visited.has(id)) return;
    visiting.add(id);
    for(const dep of graph.get(id)||[]) dfs(dep);
    visiting.delete(id);visited.add(id);
  }
  for(const id of matchIds) dfs(id);
  return true;
}

function getTopologicalMatches(){
  const matchMap = getMatchMap();
  const visited = new Set();
  const order = [];
  function visit(id){
    if(visited.has(id)) return;
    visited.add(id);
    const match = matchMap[id];
    for(const slot of match.slots){ if(slot.type !== 'team') visit(slot.matchId); }
    order.push(match);
  }
  state.config.matches.forEach(match => visit(match.id));
  return order;
}

function participantSignature(participants){
  return participants.map(value => value || null);
}
function signaturesEqual(a,b){
  return Array.isArray(a) && Array.isArray(b) && a.length===b.length && a.every((value,index)=>value===b[index]);
}

function validateScore(bestOf, scoreA, scoreB){
  const blankA = scoreA === '' || scoreA === null || scoreA === undefined;
  const blankB = scoreB === '' || scoreB === null || scoreB === undefined;
  if(blankA && blankB) return {valid:true, empty:true, scoreA:null, scoreB:null, winnerIndex:null};
  if(blankA || blankB) return {valid:false, message:'请同时填写双方比分'};
  if(!/^\d+$/.test(String(scoreA)) || !/^\d+$/.test(String(scoreB))) return {valid:false, message:'比分必须是非负整数'};
  const a = Number(scoreA), b = Number(scoreB), needed = Math.ceil(Number(bestOf)/2);
  if(a === b) return {valid:false, message:'完赛比分不能相同'};
  if(a > needed || b > needed) return {valid:false, message:`BO${bestOf} 的胜方最多 ${needed} 分`};
  if(!((a === needed && b < needed) || (b === needed && a < needed))) return {valid:false, message:`BO${bestOf} 的合法完赛比分需由一方先到 ${needed} 分`};
  return {valid:true, empty:false, scoreA:a, scoreB:b, winnerIndex:a>b?0:1};
}

function recalculateBracket(){
  const matchMap = getMatchMap();
  const participants = {}, winners = {}, losers = {};
  let mutated = false;
  for(const match of getTopologicalMatches()){
    const list = match.slots.map(slot => {
      if(slot.type === 'team') return slot.teamId || null;
      if(slot.type === 'winner') return winners[slot.matchId] || null;
      return losers[slot.matchId] || null;
    });
    participants[match.id] = list;
    if(match.kind === 'qualified'){
      winners[match.id] = list[0] || null;
      losers[match.id] = null;
      continue;
    }
    const ready = list.length === 2 && list.every(Boolean);
    let prediction = state.predictions[match.id];
    if(!prediction){ winners[match.id]=null; losers[match.id]=null; continue; }
    if(!ready){
      delete state.predictions[match.id]; mutated=true; winners[match.id]=null; losers[match.id]=null; continue;
    }
    const currentSignature = participantSignature(list);
    if(prediction.participantIds && !signaturesEqual(prediction.participantIds,currentSignature)){
      delete state.predictions[match.id]; mutated=true; winners[match.id]=null; losers[match.id]=null; continue;
    }
    if(!prediction.participantIds){ prediction.participantIds=currentSignature; mutated=true; }
    const scoreResult = validateScore(match.bestOf,prediction.scoreA,prediction.scoreB);
    if(!scoreResult.valid){ prediction.scoreA=null; prediction.scoreB=null; mutated=true; }
    if(!list.includes(prediction.winnerId)){
      prediction.winnerId=null; prediction.scoreA=null; prediction.scoreB=null; mutated=true;
    }
    if(prediction.scoreA !== null && prediction.scoreB !== null){
      const checked = validateScore(match.bestOf,prediction.scoreA,prediction.scoreB);
      if(checked.valid && !checked.empty){
        const scoreWinner = list[checked.winnerIndex];
        if(prediction.winnerId !== scoreWinner){ prediction.winnerId=scoreWinner; mutated=true; }
      }
    }
    const winner = list.includes(prediction.winnerId) ? prediction.winnerId : null;
    winners[match.id] = winner;
    losers[match.id] = winner ? (list[0]===winner ? list[1] : list[0]) : null;
    if(!prediction.winnerId && prediction.scoreA===null && prediction.scoreB===null){
      delete state.predictions[match.id]; mutated=true;
    }
  }
  resolved = {participants,winners,losers};
  if(mutated) saveState();
  return resolved;
}

function resolveMatchParticipants(matchId){
  return (resolved.participants[matchId] || []).slice();
}

function getDownstreamMatchIds(matchId){
  const dependents = new Map(state.config.matches.map(match => [match.id,[]]));
  for(const match of state.config.matches){
    for(const slot of match.slots){
      if(slot.type !== 'team' && dependents.has(slot.matchId)) dependents.get(slot.matchId).push(match.id);
    }
  }
  const result = new Set(), queue=[matchId];
  while(queue.length){
    const current=queue.shift();
    for(const next of dependents.get(current)||[]){
      if(!result.has(next)){ result.add(next); queue.push(next); }
    }
  }
  return result;
}

function clearInvalidDownstreamPredictions(matchId){
  for(const id of getDownstreamMatchIds(matchId)) delete state.predictions[id];
}

function selectWinner(matchId, teamId){
  if(state.ui.mode !== 'predict') return;
  const match = getMatchMap()[matchId];
  if(!match || match.kind !== 'match') return;
  const participants = resolveMatchParticipants(matchId);
  if(participants.length !== 2 || !participants.every(Boolean) || !participants.includes(teamId)) return;
  pushHistory();
  const existing = state.predictions[matchId] || {scoreA:null,scoreB:null,winnerId:null,participantIds:participantSignature(participants)};
  const nextWinner = existing.winnerId === teamId ? null : teamId;
  if(existing.winnerId !== nextWinner) clearInvalidDownstreamPredictions(matchId);
  if(existing.scoreA !== null || existing.scoreB !== null){
    const scoreResult = validateScore(match.bestOf,existing.scoreA,existing.scoreB);
    const scoreWinner = scoreResult.valid && !scoreResult.empty ? participants[scoreResult.winnerIndex] : null;
    if(scoreWinner !== nextWinner){ existing.scoreA=null; existing.scoreB=null; }
  }
  existing.winnerId = nextWinner;
  existing.participantIds = participantSignature(participants);
  if(!nextWinner && existing.scoreA===null && existing.scoreB===null) delete state.predictions[matchId];
  else state.predictions[matchId]=existing;
  saveState();
  renderTournament();
}

function setScore(matchId, scoreA, scoreB){
  if(state.ui.mode !== 'predict') return false;
  const match = getMatchMap()[matchId];
  const participants = resolveMatchParticipants(matchId);
  if(!match || match.kind !== 'match' || participants.length!==2 || !participants.every(Boolean)) return false;
  const checked = validateScore(match.bestOf,scoreA,scoreB);
  if(!checked.valid){ markScoreError(matchId,checked.message); return false; }
  const previous = state.predictions[matchId] || {scoreA:null,scoreB:null,winnerId:null,participantIds:participantSignature(participants)};
  const oldWinner = previous.winnerId || null;
  const nextWinner = checked.empty ? oldWinner : participants[checked.winnerIndex];
  const noChange = previous.scoreA===checked.scoreA && previous.scoreB===checked.scoreB && previous.winnerId===nextWinner;
  if(noChange){ clearScoreError(matchId); return true; }
  pushHistory();
  if(oldWinner !== nextWinner) clearInvalidDownstreamPredictions(matchId);
  const next = {
    scoreA: checked.scoreA,
    scoreB: checked.scoreB,
    winnerId: nextWinner,
    participantIds: participantSignature(participants)
  };
  if(!next.winnerId && next.scoreA===null && next.scoreB===null) delete state.predictions[matchId];
  else state.predictions[matchId]=next;
  clearScoreError(matchId);
  saveState();
  renderTournament();
  return true;
}

function scheduleScoreValidation(matchId){
  clearTimeout(scoreTimers.get(matchId));
  scoreTimers.set(matchId,setTimeout(()=>{
    const inputs=[...document.querySelectorAll(`.score-input[data-match-id="${CSS.escape(matchId)}"]`)];
    if(inputs.length!==2) return;
    const values=inputs.sort((a,b)=>Number(a.dataset.slotIndex)-Number(b.dataset.slotIndex)).map(input=>input.value.trim());
    if(values.every(value=>value==='')) setScore(matchId,'','');
    else if(values.every(value=>value!=='')) setScore(matchId,values[0],values[1]);
  },450));
}

function markScoreError(matchId,message){
  const card=document.getElementById(`card-${matchId}`);
  if(!card) return;
  card.classList.add('score-error');
  const error=card.querySelector('.match-error');
  if(error){ error.textContent=message; error.title=message; }
}
function clearScoreError(matchId){
  const card=document.getElementById(`card-${matchId}`);
  if(!card) return;
  card.classList.remove('score-error');
  const error=card.querySelector('.match-error'); if(error) error.textContent='';
}

function renderLogo(team,extraClass=''){
  const fallback=`<span class="logo-fallback${team && !team.logo?' visible':''}">${escapeHtml(initials(team?.name))}</span>`;
  if(!team || !team.logo) return `<span class="logo-box ${extraClass}">${fallback}</span>`;
  return `<span class="logo-box ${extraClass}"><img class="team-logo-img" src="${escapeAttribute(team.logo)}" alt="${escapeAttribute(team.name)}" data-team-name="${escapeAttribute(team.name)}">${fallback}</span>`;
}

function renderTeamRow(match,teamId,slotIndex){
  const teams=getTeamMap();
  const team=teamId?teams[teamId]:null;
  const prediction=state.predictions[match.id]||{};
  const winner=resolved.winners[match.id];
  const loser=resolved.losers[match.id];
  const slot=match.slots[slotIndex];
  const classes=['team-row'];
  if(team) classes.push('resolved'); else classes.push('pending');
  if(teamId && winner===teamId) classes.push('winner');
  if(teamId && loser===teamId) classes.push('loser');
  const scoreValue=slotIndex===0?prediction.scoreA:prediction.scoreB;
  const source=sourceDescription(slot);
  const teamName=team?team.name:(source||'TBD');
  return `<div class="${classes.join(' ')}" data-match-id="${escapeAttribute(match.id)}" data-team-id="${escapeAttribute(teamId||'')}" data-slot-index="${slotIndex}" title="${escapeAttribute(teamName)}">
    ${team?renderLogo(team):`<span class="logo-box"><span class="logo-fallback visible">?</span></span>`}
    <span class="team-name">${escapeHtml(teamName)}</span>
    ${!team && source?`<span class="source-badge" title="${escapeAttribute(source)}">${escapeHtml(source)}</span>`:''}
    ${teamId && winner===teamId?'<span class="winner-mark">✓</span>':''}
    <input class="score-input predict-only" data-match-id="${escapeAttribute(match.id)}" data-slot-index="${slotIndex}" inputmode="numeric" maxlength="1" value="${scoreValue===null||scoreValue===undefined?'':escapeAttribute(scoreValue)}" ${team?'':'disabled'} aria-label="${escapeAttribute(teamName)} 比分">
  </div>`;
}

function renderMatchCard(match,group){
  const participants=resolved.participants[match.id]||[];
  const winner=resolved.winners[match.id];
  const ready=participants.length===2 && participants.every(Boolean);
  const roundName=group.roundNames[match.roundKey]||match.roundKey;
  return `<article class="match-card ${ready?'ready':''} ${winner?'decided':''}" id="card-${escapeAttribute(match.id)}" data-match-id="${escapeAttribute(match.id)}" style="left:${Number(match.layout?.x)||0}px;top:${Number(match.layout?.y)||0}px">
    <div class="match-top"><span class="match-label">${escapeHtml(match.label)}</span><span class="match-round" title="${escapeAttribute(roundName)}">${escapeHtml(roundName)}</span></div>
    ${renderTeamRow(match,participants[0]||null,0)}
    ${renderTeamRow(match,participants[1]||null,1)}
    <div class="match-foot"><span class="match-time" title="${escapeAttribute(match.scheduledAt||'未设置时间')}">${escapeHtml(match.scheduledAt||'未设置时间')}</span><span class="match-error"></span><span class="bo-badge">BO${match.bestOf}</span></div>
  </article>`;
}

function renderQualifiedCard(match,group){
  const teamId=(resolved.participants[match.id]||[])[0]||null;
  const team=getTeamMap()[teamId];
  const roundName=group.roundNames[match.roundKey]||match.roundKey;
  const source=sourceDescription(match.slots[0]);
  return `<article class="qualified-card ${team?'':'pending'}" id="card-${escapeAttribute(match.id)}" data-match-id="${escapeAttribute(match.id)}" style="left:${Number(match.layout?.x)||0}px;top:${Number(match.layout?.y)||0}px" title="${escapeAttribute(source)}">
    ${team?renderLogo(team):'<span class="logo-box"><span class="logo-fallback visible">?</span></span>'}
    <div class="qualified-meta"><div class="qualified-label">${escapeHtml(roundName)}</div><div class="qualified-name">${escapeHtml(team?team.name:source||'TBD')}</div></div>
  </article>`;
}

function renderGroup(group){
  const groupMatches=state.config.matches.filter(match=>match.groupId===group.id);
  const decisions=groupMatches.filter(match=>match.kind==='match');
  const completed=decisions.filter(match=>resolved.winners[match.id]).length;
  const qualified=groupMatches.filter(match=>match.kind==='qualified');
  const layout=state.config.layout||{width:1040,height:945};
  const cards=groupMatches.map(match=>match.kind==='qualified'?renderQualifiedCard(match,group):renderMatchCard(match,group)).join('');
  const summary=qualified.map(match=>{
    const teamId=(resolved.participants[match.id]||[])[0]||null;
    const team=getTeamMap()[teamId];
    const roundName=group.roundNames[match.roundKey]||match.roundKey;
    return `<div class="summary-card ${team?'':'pending'}">${team?renderLogo(team):'<span class="logo-box"><span class="logo-fallback visible">?</span></span>'}<div style="min-width:0"><strong title="${escapeAttribute(team?.name||'TBD')}">${escapeHtml(team?.name||'TBD')}</strong><small>${escapeHtml(roundName)}</small></div></div>`;
  }).join('');
  return `<section class="group-panel" data-group-id="${escapeAttribute(group.id)}">
    <div class="group-head"><span class="group-name">${escapeHtml(group.name)}</span><span class="group-progress"><strong>${completed}</strong> / ${decisions.length} 场已预测</span></div>
    <div class="group-viewport" data-group-viewport="${escapeAttribute(group.id)}">
      <div class="bracket-stage" data-stage="${escapeAttribute(group.id)}" style="width:${layout.width*state.ui.zoom}px;height:${layout.height*state.ui.zoom}px">
        <div class="bracket-scale" data-scale="${escapeAttribute(group.id)}" style="width:${layout.width}px;height:${layout.height}px;transform:scale(${state.ui.zoom})">
          <div class="bracket-board" data-board="${escapeAttribute(group.id)}" style="width:${layout.width}px;height:${layout.height}px">
            <span class="zone-label upper">Upper Bracket</span><span class="zone-label lower">Lower Bracket</span>
            <div class="round-header upper c1">${escapeHtml(group.roundNames.upperQuarterfinals)}</div>
            <div class="round-header upper c2">${escapeHtml(group.roundNames.upperSemifinals)}</div>
            <div class="round-header upper c3">${escapeHtml(group.roundNames.upperQualified)}</div>
            <div class="round-header lower c1">${escapeHtml(group.roundNames.lowerQuarterfinals)}</div>
            <div class="round-header lower c2">${escapeHtml(group.roundNames.lowerSemifinal)}</div>
            <div class="round-header lower c3">${escapeHtml(group.roundNames.lowerQualified)}</div>
            <svg class="route-svg" data-route-svg="${escapeAttribute(group.id)}" viewBox="0 0 ${layout.width} ${layout.height}" preserveAspectRatio="none"></svg>
            ${cards}
          </div>
        </div>
      </div>
    </div>
    <div class="qualified-summary">${summary}</div>
    <div class="group-help">点击队伍即可选择或取消胜者；填写双方合法完赛比分会自动判断胜者。修改上游结果后，受影响的下游预测会自动清除。</div>
  </section>`;
}

function renderTournament(){
  recalculateBracket();
  document.documentElement.dataset.theme='light';
  document.body.classList.toggle('mode-edit',state.ui.mode==='edit');
  document.body.classList.toggle('mode-predict',state.ui.mode!=='edit');
  pageTitle.textContent=state.config.tournamentName;
  modeTitle.textContent=state.ui.mode==='edit'?'编辑模式':'预测模式';
  modeCopy.textContent=state.ui.mode==='edit'?'队伍点击和比分输入已禁用；通过“编辑赛事配置”修改小组、轮次、队伍、Logo、初始对阵、BO 和时间。':'点击队伍选择胜者，或填写合法比分自动判断胜者。';
  document.getElementById('modeButton').textContent=state.ui.mode==='edit'?'切换到预测模式':'切换到编辑模式';
  zoomLabel.textContent=`${Math.round(state.ui.zoom*100)}%`;
  groupsGrid.innerHTML=state.config.groups.map(renderGroup).join('');
  updateUndoButton();
  requestConnectionUpdate();
}

function requestConnectionUpdate(){
  cancelAnimationFrame(connectionFrame);
  connectionFrame=requestAnimationFrame(updateConnections);
}

function orthogonalPath(x1,y1,x2,y2,mode='normal'){
  if(mode==='same-left'){
    const outer=Math.max(8,Math.min(x1,x2)-24);
    return `M ${x1} ${y1} L ${outer} ${y1} L ${outer} ${y2} L ${x2} ${y2}`;
  }
  if(mode==='same-right'){
    const outer=Math.max(x1,x2)+34;
    return `M ${x1} ${y1} L ${outer} ${y1} L ${outer} ${y2} L ${x2} ${y2}`;
  }
  const middle=x1+(x2-x1)*.5;
  return `M ${x1} ${y1} L ${middle} ${y1} L ${middle} ${y2} L ${x2} ${y2}`;
}

function updateConnections(){
  const matchMap=getMatchMap();
  for(const group of state.config.groups){
    const board=document.querySelector(`[data-board="${CSS.escape(group.id)}"]`);
    const svg=document.querySelector(`[data-route-svg="${CSS.escape(group.id)}"]`);
    if(!board||!svg) continue;
    const boardRect=board.getBoundingClientRect();
    const scale=boardRect.width/(Number(state.config.layout?.width)||1040) || 1;
    const paths=[];
    for(const match of state.config.matches.filter(item=>item.groupId===group.id && item.kind==='match')){
      for(const [edgeType,edge] of [['winner',match.winnerTo],['loser',match.loserTo]]){
        if(!edge) continue;
        const sourceCard=document.getElementById(`card-${match.id}`);
        const targetCard=document.getElementById(`card-${edge.matchId}`);
        if(!sourceCard||!targetCard) continue;
        const sourceResolved=edgeType==='winner'?resolved.winners[match.id]:resolved.losers[match.id];
        const sourceRow=sourceResolved?sourceCard.querySelector(`.team-row[data-team-id="${CSS.escape(sourceResolved)}"]`):null;
        const targetRow=targetCard.querySelector(`.team-row[data-slot-index="${edge.slotIndex}"]`);
        const sr=(sourceRow||sourceCard).getBoundingClientRect();
        const tr=(targetRow||targetCard).getBoundingClientRect();
        const sourceLeft=(sr.left-boardRect.left)/scale, sourceRight=(sr.right-boardRect.left)/scale, sourceY=(sr.top+sr.height/2-boardRect.top)/scale;
        const targetLeft=(tr.left-boardRect.left)/scale, targetRight=(tr.right-boardRect.left)/scale, targetY=(tr.top+tr.height/2-boardRect.top)/scale;
        const sourceCardX=(sourceCard.getBoundingClientRect().left-boardRect.left)/scale;
        const targetCardX=(targetCard.getBoundingClientRect().left-boardRect.left)/scale;
        let d;
        if(Math.abs(sourceCardX-targetCardX)<20){
          if(sourceCardX<200) d=orthogonalPath(sourceLeft,sourceY,targetLeft,targetY,'same-left');
          else d=orthogonalPath(sourceRight,sourceY,targetRight,targetY,'same-right');
        }else d=orthogonalPath(sourceRight,sourceY,targetLeft,targetY,'normal');
        const active=Boolean(sourceResolved);
        paths.push(`<path class="route ${edgeType} ${active?'active':''}" d="${d}"><title>${escapeHtml(edgeType==='winner'?'Winner route':'Loser route')}</title></path>`);
      }
    }
    svg.innerHTML=paths.join('');
  }
}

function handleLogoError(img){
  img.style.display='none';
  const fallback=img.parentElement?.querySelector('.logo-fallback');
  if(fallback) fallback.classList.add('visible');
}

function resetPredictions(){
  if(Object.keys(state.predictions).length===0){ showToast('当前没有预测结果'); return; }
  if(!confirm('确定清空所有预测和比分吗？赛事配置不会改变。')) return;
  pushHistory(); state.predictions={}; saveState(); renderTournament(); showToast('已清空所有预测');
}

function restoreDefaultConfig(){
  if(!confirm('确定恢复默认赛事配置和初始对阵吗？所有预测也会清空。')) return;
  pushHistory(); state.config=deepClone(DEFAULT_CONFIG); state.predictions={}; editorDraft=null; saveState(); renderTournament(); closeModal('editorModal'); showToast('已恢复默认赛事配置');
}

function buildExportPayload(){
  return {
    schemaVersion:SCHEMA_VERSION,
    app:'owcs-bracket-predictor',
    tournamentName:state.config.tournamentName,
    groups:deepClone(state.config.groups),
    teams:deepClone(state.config.teams),
    matches:deepClone(state.config.matches),
    layout:deepClone(state.config.layout),
    sourceUrl:state.config.sourceUrl,
    timezone:state.config.timezone,
    predictions:deepClone(state.predictions),
    ui:deepClone(state.ui),
    updatedAt:new Date().toISOString()
  };
}

function exportJson(){
  const payload=buildExportPayload();
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const link=document.createElement('a');
  link.href=url; link.download=`owcs-bracket-prediction-${new Date().toISOString().replace(/[:.]/g,'-')}.json`;
  document.body.appendChild(link); link.click(); link.remove(); URL.revokeObjectURL(url);
  showToast('JSON 已导出');
}

function normalizeImportPayload(payload){
  if(!payload || typeof payload!=='object') throw new Error('JSON 根节点必须是对象');
  if(payload.schemaVersion!==SCHEMA_VERSION) throw new Error(`不支持的 schemaVersion：${payload.schemaVersion}`);
  const config=payload.config ? payload.config : {
    schemaVersion:SCHEMA_VERSION,
    tournamentName:payload.tournamentName,
    sourceUrl:payload.sourceUrl||'',
    timezone:payload.timezone||'',
    layout:payload.layout||{width:1040,height:945},
    groups:payload.groups,
    teams:payload.teams,
    matches:payload.matches
  };
  validateConfig(config);
  const matchMap=Object.fromEntries(config.matches.map(match=>[match.id,match]));
  const teamIds=new Set(config.teams.map(team=>team.id));
  const predictions={};
  if(payload.predictions!==undefined && (typeof payload.predictions!=='object'||Array.isArray(payload.predictions))) throw new Error('predictions 必须是对象');
  for(const [matchId,prediction] of Object.entries(payload.predictions||{})){
    if(!matchMap[matchId] || matchMap[matchId].kind!=='match') throw new Error(`predictions 包含无效比赛 ${matchId}`);
    if(!prediction || typeof prediction!=='object') throw new Error(`比赛 ${matchId} 的预测格式无效`);
    if(prediction.winnerId!==null && prediction.winnerId!==undefined && !teamIds.has(prediction.winnerId)) throw new Error(`比赛 ${matchId} 的 winnerId 无效`);
    predictions[matchId]={
      scoreA:prediction.scoreA===undefined?null:prediction.scoreA,
      scoreB:prediction.scoreB===undefined?null:prediction.scoreB,
      winnerId:prediction.winnerId||null,
      participantIds:Array.isArray(prediction.participantIds)?prediction.participantIds.slice(0,2):null
    };
  }
  return {
    schemaVersion:SCHEMA_VERSION,
    config:deepClone(config),
    predictions,
    ui:{...DEFAULT_UI,...(payload.ui||{})},
    updatedAt:typeof payload.updatedAt==='string'?payload.updatedAt:new Date().toISOString()
  };
}

function importJson(fileOrText){
  const applyText=text=>{
    try{
      const imported=normalizeImportPayload(JSON.parse(text));
      pushHistory(); state=imported; saveState(); renderTournament(); showToast('JSON 导入成功');
    }catch(error){
      alert(`导入失败：${error.message}`);
    }
  };
  if(typeof fileOrText==='string'){ applyText(fileOrText); return; }
  const file=fileOrText;
  if(!file) return;
  const reader=new FileReader();
  reader.onload=()=>applyText(String(reader.result||''));
  reader.onerror=()=>alert('无法读取所选文件');
  reader.readAsText(file,'utf-8');
}

function buildPredictionText(){
  recalculateBracket();
  const teams=getTeamMap();
  const groups=getGroupMap();
  const lines=[state.config.tournamentName,`更新时间：${new Date().toLocaleString()}`,''];
  for(const group of state.config.groups){
    lines.push(`[${group.name}]`);
    for(const match of state.config.matches.filter(m=>m.groupId===group.id&&m.kind==='match')){
      const p=resolved.participants[match.id]||[];
      const a=teams[p[0]]?.name||sourceDescription(match.slots[0])||'TBD';
      const b=teams[p[1]]?.name||sourceDescription(match.slots[1])||'TBD';
      const pred=state.predictions[match.id]||{};
      const score=pred.scoreA!==null&&pred.scoreA!==undefined&&pred.scoreB!==null&&pred.scoreB!==undefined?` ${pred.scoreA}:${pred.scoreB}`:'';
      const winner=teams[resolved.winners[match.id]]?.name;
      lines.push(`${match.label}｜${a}${score?` ${score.trim()} `:' vs '}${b}${winner?`｜胜者：${winner}`:''}`);
    }
    const qualified=state.config.matches.filter(m=>m.groupId===group.id&&m.kind==='qualified').map(m=>teams[(resolved.participants[m.id]||[])[0]]?.name||'TBD');
    lines.push(`Qualified：${qualified.join('、')}`,'');
  }
  return lines.join('\n');
}

async function copyText(text){
  try{
    await navigator.clipboard.writeText(text);
  }catch{
    const textarea=document.createElement('textarea');textarea.value=text;textarea.style.position='fixed';textarea.style.opacity='0';document.body.appendChild(textarea);textarea.select();document.execCommand('copy');textarea.remove();
  }
}

function copyPredictionText(){
  const text=buildPredictionText();
  copyText(text).then(()=>showToast('预测结果文本已复制'));
}

