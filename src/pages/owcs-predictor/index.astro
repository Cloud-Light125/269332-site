.field input,.field select,.field textarea,.editor-table input,.editor-table select,.data-textarea,.score-input {border-color:var(--color-border)}
.modal {background:rgba(24,32,43,.58)}
.toast {border-color:#3d4a58;border-radius:var(--radius-small);box-shadow:var(--shadow-medium)}
.footer-note {margin:1rem 0 2rem;color:var(--color-text-muted);font-size:.8rem}
.site-footer {margin-top:2rem;padding:3.5rem 1rem 2rem;background:#101923;color:#bdc8d5}
.footer-inner,.footer-bottom {width:min(var(--content-width),100%);margin:0 auto}
.footer-inner {display:grid;grid-template-columns:minmax(0,1.5fr) repeat(2,minmax(10rem,.75fr));gap:2rem;padding-bottom:2.5rem}
.footer-brand>a {color:#fff;font-size:1.25rem;font-weight:700;letter-spacing:.08em;text-decoration:none}
