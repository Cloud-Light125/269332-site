function renderEditor(){
  if(!editorDraft) return;
  const group=editorDraft.groups.find(item=>item.id===editorGroupId)||editorDraft.groups[0];
  const groupTeams=editorDraft.teams.filter(team=>team.groupId===group.id);
  const groupMatches=editorDraft.matches.filter(match=>match.groupId===group.id&&match.kind==='match');
  const teamOptions=groupTeams.map(team=>`<option value="${escapeAttribute(team.id)}">${escapeHtml(team.name)}</option>`).join('');
  const rounds=Object.entries(group.roundNames).map(([key,value])=>`<label class="field"><span>${escapeHtml(key)}</span><input data-editor-kind="round" data-round-key="${escapeAttribute(key)}" value="${escapeAttribute(value)}"></label>`).join('');
  const teamRows=groupTeams.map(team=>`<tr><td>${escapeHtml(team.id)}</td><td><input data-editor-kind="team-name" data-team-id="${escapeAttribute(team.id)}" value="${escapeAttribute(team.name)}"></td><td><input data-editor-kind="team-short" data-team-id="${escapeAttribute(team.id)}" value="${escapeAttribute(team.shortName||'')}"></td><td><input class="logo-input" data-editor-kind="team-logo" data-team-id="${escapeAttribute(team.id)}" value="${team.logo&&String(team.logo).startsWith('data:')?'':escapeAttribute(team.logo||'')}" placeholder="粘贴新的 Logo URL 或 data URI；留空保持当前值"></td></tr>`).join('');
  const matchRows=groupMatches.map(match=>{
    const slots=match.slots.map((slot,index)=>{
      if(slot.type==='team') return `<select data-editor-kind="slot-team" data-match-id="${escapeAttribute(match.id)}" data-slot-index="${index}">${teamOptions.replace(`value="${slot.teamId}"`,`value="${slot.teamId}" selected`)}</select>`;
      return `<span class="source-static">${escapeHtml(sourceDescriptionForConfig(slot,editorDraft))}</span>`;
    });
    return `<tr><td>${escapeHtml(match.id)}</td><td><input data-editor-kind="match-label" data-match-id="${escapeAttribute(match.id)}" value="${escapeAttribute(match.label)}"></td><td>${slots[0]}</td><td>${slots[1]}</td><td><select data-editor-kind="match-bo" data-match-id="${escapeAttribute(match.id)}"><option value="1" ${match.bestOf===1?'selected':''}>BO1</option><option value="3" ${match.bestOf===3?'selected':''}>BO3</option><option value="5" ${match.bestOf===5?'selected':''}>BO5</option></select></td><td><input data-editor-kind="match-time" data-match-id="${escapeAttribute(match.id)}" value="${escapeAttribute(match.scheduledAt||'')}"></td></tr>`;
  }).join('');
  editorBody.innerHTML=`
    <div class="form-grid">
      <label class="field"><span>赛事名称</span><input data-editor-kind="tournament-name" value="${escapeAttribute(editorDraft.tournamentName||'')}"></label>
      <label class="field"><span>当前小组名称</span><input data-editor-kind="group-name" value="${escapeAttribute(group.name||'')}"></label>
    </div>
    <div class="editor-tabs">${editorDraft.groups.map(item=>`<button class="editor-tab ${item.id===group.id?'active':''}" data-editor-group="${escapeAttribute(item.id)}">${escapeHtml(item.name)}</button>`).join('')}</div>
    <section class="editor-section"><h3>轮次名称</h3><div class="editor-section-body"><div class="form-grid">${rounds}</div></div></section>
    <section class="editor-section"><h3>队伍名称与 Logo</h3><div class="editor-table-wrap"><table class="editor-table"><thead><tr><th>ID</th><th>队伍名称</th><th>简称</th><th>Logo 地址</th></tr></thead><tbody>${teamRows}</tbody></table></div></section>
    <section class="editor-section"><h3>比赛、初始对阵、BO 与时间</h3><div class="editor-table-wrap"><table class="editor-table"><thead><tr><th>比赛 ID</th><th>比赛标签</th><th>位置 1</th><th>位置 2</th><th>赛制</th><th>日期和时间</th></tr></thead><tbody>${matchRows}</tbody></table></div></section>`;
}

function sourceDescriptionForConfig(slot,config){
  if(slot.type==='team') return '';
  const source=config.matches.find(match=>match.id===slot.matchId);
  return `${slot.type==='winner'?'Winner of':'Loser of'} ${source?.label||slot.matchId}`;
}

function syncEditorField(target){
  if(!editorDraft) return;
  const kind=target.dataset.editorKind;
  const group=editorDraft.groups.find(item=>item.id===editorGroupId);
  if(kind==='tournament-name') editorDraft.tournamentName=target.value.trim()||'Untitled Tournament';
  if(kind==='group-name') group.name=target.value.trim()||group.id;
  if(kind==='round') group.roundNames[target.dataset.roundKey]=target.value.trim()||target.dataset.roundKey;
  if(kind?.startsWith('team-')){
    const team=editorDraft.teams.find(item=>item.id===target.dataset.teamId); if(!team) return;
    if(kind==='team-name') team.name=target.value.trim()||team.id;
    if(kind==='team-short') team.shortName=target.value.trim()||team.id.toUpperCase();
    if(kind==='team-logo' && target.value.trim()) team.logo=target.value.trim();
  }
  if(kind?.startsWith('match-')||kind==='slot-team'){
    const match=editorDraft.matches.find(item=>item.id===target.dataset.matchId); if(!match) return;
    if(kind==='match-label') match.label=target.value.trim()||match.id;
    if(kind==='match-bo') match.bestOf=Number(target.value);
    if(kind==='match-time') match.scheduledAt=target.value.trim();
    if(kind==='slot-team') match.slots[Number(target.dataset.slotIndex)]={type:'team',teamId:target.value};
  }
}

function applyEditorChanges(){
  try{ validateConfig(editorDraft); }
  catch(error){ alert(`配置无效：${error.message}`); return; }
  pushHistory(); state.config=deepClone(editorDraft); saveState(); closeModal('editorModal'); renderTournament(); showToast('赛事配置已更新');
}

function setZoom(nextZoom){
  state.ui.zoom=clamp(Math.round(nextZoom*100)/100,.45,1.6);saveState();renderTournament();
}
function fitToWindow(){
  const viewports=[...document.querySelectorAll('[data-group-viewport]')];
  if(!viewports.length) return;
  const width=Number(state.config.layout?.width)||1040;
  const smallest=Math.min(...viewports.map(viewport=>viewport.clientWidth-24));
  setZoom(clamp(smallest/width,.45,1.25));
}
async function toggleFullscreen(){
  try{
    if(!document.fullscreenElement) await document.documentElement.requestFullscreen(); else await document.exitFullscreen();
  }catch{ showToast('当前浏览器不允许全屏'); }
}

function showToast(message){
  clearTimeout(toastTimer);toastElement.textContent=message;toastElement.classList.add('show');toastTimer=setTimeout(()=>toastElement.classList.remove('show'),2200);
}

// Event delegation for bracket interactions.
groupsGrid.addEventListener('click',event=>{
  const row=event.target.closest('.team-row');
  if(!row || event.target.closest('.score-input')) return;
  const teamId=row.dataset.teamId;
  if(teamId) selectWinner(row.dataset.matchId,teamId);
});
groupsGrid.addEventListener('input',event=>{
  if(event.target.matches('.score-input')) scheduleScoreValidation(event.target.dataset.matchId);
});
groupsGrid.addEventListener('blur',event=>{
  if(!event.target.matches('.score-input')) return;
  const matchId=event.target.dataset.matchId;
  const inputs=[...document.querySelectorAll(`.score-input[data-match-id="${CSS.escape(matchId)}"]`)];
  const values=inputs.sort((a,b)=>Number(a.dataset.slotIndex)-Number(b.dataset.slotIndex)).map(input=>input.value.trim());
  if(values.some(Boolean)&&values.some(value=>!value)) markScoreError(matchId,'请同时填写双方比分');
},true);
groupsGrid.addEventListener('error',event=>{
  if(event.target.matches('.team-logo-img')) handleLogoError(event.target);
},true);

editorBody.addEventListener('click',event=>{
  const tab=event.target.closest('[data-editor-group]');
  if(tab){
    editorBody.querySelectorAll('[data-editor-kind]').forEach(syncEditorField);
    editorGroupId=tab.dataset.editorGroup;renderEditor();
  }
});
editorBody.addEventListener('change',event=>{
  if(event.target.dataset.editorKind) syncEditorField(event.target);
});

// Toolbar actions.
document.getElementById('modeButton').addEventListener('click',()=>{
  state.ui.mode=state.ui.mode==='edit'?'predict':'edit';saveState();renderTournament();if(state.ui.mode==='edit') openEditor();
});
document.getElementById('editConfigButton').addEventListener('click',openEditor);
document.getElementById('saveButton').addEventListener('click',()=>saveState(true));
document.getElementById('undoButton').addEventListener('click',undoLastAction);
document.getElementById('resetPredictionsButton').addEventListener('click',resetPredictions);
document.getElementById('restoreDefaultsButton').addEventListener('click',restoreDefaultConfig);
document.getElementById('exportButton').addEventListener('click',exportJson);
document.getElementById('importButton').addEventListener('click',()=>{importFile.value='';importFile.click();});
document.getElementById('copyButton').addEventListener('click',copyPredictionText);
document.getElementById('zoomOutButton').addEventListener('click',()=>setZoom(state.ui.zoom-.1));
document.getElementById('zoomInButton').addEventListener('click',()=>setZoom(state.ui.zoom+.1));
document.getElementById('zoomResetButton').addEventListener('click',()=>setZoom(1));
document.getElementById('fitButton').addEventListener('click',fitToWindow);
document.getElementById('fullscreenButton').addEventListener('click',toggleFullscreen);
importFile.addEventListener('change',event=>importJson(event.target.files?.[0]));
document.getElementById('editorApplyButton').addEventListener('click',()=>{editorBody.querySelectorAll('[data-editor-kind]').forEach(syncEditorField);applyEditorChanges();});
document.getElementById('editorRestoreButton').addEventListener('click',restoreDefaultConfig);
document.getElementById('copyModalButton').addEventListener('click',()=>copyText(dataTextarea.value).then(()=>showToast('已复制')));
applyModalButton.addEventListener('click',()=>importJson(dataTextarea.value));
document.querySelectorAll('[data-close-modal]').forEach(button=>button.addEventListener('click',()=>closeModal(button.dataset.closeModal)));
document.querySelectorAll('.modal').forEach(modal=>modal.addEventListener('click',event=>{if(event.target===modal) closeModal(modal.id);}));
window.addEventListener('resize',requestConnectionUpdate);
window.addEventListener('load',requestConnectionUpdate);
if('ResizeObserver' in window){
  const observer=new ResizeObserver(requestConnectionUpdate);observer.observe(document.body);
}
document.addEventListener('keydown',event=>{
  if(event.key==='Escape'){closeModal('editorModal');closeModal('dataModal');}
  if((event.ctrlKey||event.metaKey)&&event.key.toLowerCase()==='z'&&!event.target.matches('input,textarea,select')){event.preventDefault();undoLastAction();}
});

document.getElementById('copyrightYear').textContent=String(new Date().getFullYear());
renderTournament();
</script>
</body>
</html>
