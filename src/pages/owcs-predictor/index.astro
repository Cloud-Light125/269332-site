.qualified-card .logo-box{width:37px;height:35px;flex-basis:37px}.qualified-card .team-logo-img{max-width:37px;max-height:34px}.qualified-card .logo-fallback{width:34px;height:32px}.qualified-meta{min-width:0}.qualified-label{font-size:9px;color:var(--qualified);font-weight:900;letter-spacing:.1em;text-transform:uppercase}.qualified-name{font-size:13px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.qualified-card.pending .qualified-name{color:var(--muted);font-style:italic;font-weight:600}
