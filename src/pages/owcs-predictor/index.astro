.global-links a {display:inline-flex;align-items:center;justify-content:center;padding:.55rem .8rem;border-radius:var(--radius-small);color:var(--color-text-muted);font-size:.9rem;font-weight:600;text-decoration:none}
.global-links a:hover {background:var(--color-surface-muted);color:var(--color-text)}
.global-links a[aria-current="page"] {background:var(--color-accent-soft);color:var(--color-accent-hover)}
.global-repo {display:inline-flex;flex:0 0 auto;align-items:center;gap:.3rem;padding:.5rem .7rem;border:1px solid var(--color-border);border-radius:var(--radius-small);color:var(--color-text);font-size:.84rem;font-weight:700;text-decoration:none}
.global-repo:hover {background:var(--color-surface);border-color:var(--color-accent);color:var(--color-accent-hover)}
.app {width:min(2200px,100%);max-width:none;margin:0 auto;padding:1.25rem 1rem 0}
.topbar {align-items:flex-start;margin-bottom:1rem;padding:clamp(1rem,2.4vw,1.6rem);border:1px solid var(--color-border);border-radius:var(--radius-large);background:var(--color-surface);box-shadow:var(--shadow-small)}
.title-wrap {min-width:min(28rem,100%)}
.eyebrow {color:var(--color-accent-hover)}
h1 {font-size:clamp(1.8rem,3.2vw,3.15rem);letter-spacing:-.025em}
.subtitle {max-width:52rem;color:var(--color-text-muted);font-size:.9rem;line-height:1.7}
.toolbar {gap:.5rem}
.btn {min-height:40px;padding:.55rem .8rem;border-color:var(--color-border);border-radius:var(--radius-small);background:var(--color-surface);box-shadow:none;font-weight:700;transition:border-color .16s ease,background-color .16s ease,color .16s ease,transform .16s ease}
.btn:hover {border-color:var(--color-accent);background:var(--color-accent-soft);color:var(--color-accent-hover)}
.btn.primary {background:var(--color-accent);border-color:var(--color-accent)}
.btn.primary:hover {background:var(--color-accent-hover);color:#fff}
.btn.orange {background:#8a4b0f;border-color:#8a4b0f}
.btn.orange:hover {background:#6f3c0c;color:#fff}
.mode-banner,.group-panel,.modal-card {border-color:var(--color-border);border-radius:var(--radius-medium);box-shadow:var(--shadow-small)}
.mode-banner {padding:.8rem 1rem}
.group-head {background:var(--color-surface-muted)}
.group-viewport {background:linear-gradient(180deg,var(--color-surface),var(--color-surface-muted))}
.bracket-board {border-radius:var(--radius-small)}
.match-card,.qualified-card,.summary-card {border-color:var(--color-border);box-shadow:0 4px 12px rgba(24,32,43,.07)}
