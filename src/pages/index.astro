---
import CategoryBrowse from '../components/home/CategoryBrowse.astro';
import FeaturedCatalog from '../components/home/FeaturedCatalog.astro';
import HomeHero from '../components/home/HomeHero.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { gameTools, projects } from '../data/catalog';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';

const pickProject = (id: string) => projects.find((project) => project.id === id)!;

const heroItems = [
	pickProject('cloudlight-automator'),
	pickProject('cloudlight-codex-bridge'),
	pickProject('heybox-post-exporter'),
];
const featuredProjects = [
	pickProject('cloudlight-overwatch-youtube-watcher'),
	pickProject('twitter-x-media-renamer'),
	pickProject('heybox-post-exporter'),
];
const directUseItems = [...gameTools, pickProject('heybox-post-export-userscript')];
const latestPosts = (await getPublishedPosts()).slice(0, 3);

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: 'https://269332.xyz',
	description: SITE_DESCRIPTION,
};
---

<BaseLayout title="CloudLight · 实用软件、网页工具与博客" description={SITE_DESCRIPTION}>
	<script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
	<main class="home">
		<HomeHero items={heroItems} />

		<FeaturedCatalog
			id="featured-projects"
			label="精选项目"
			title="先看看这些实用工具"
			description="每个项目都写清楚了用途、适合的场景、使用步骤和获取方式。"
			items={featuredProjects}
			allHref="/projects/"
			allLabel="浏览全部项目"
		/>

		<FeaturedCatalog
			id="direct-use"
			label="直接使用"
			title="不用下载安装的工具"
			description="打开在线工具即可开始；浏览器脚本会跳转到安装页面。"
			items={directUseItems}
			allHref="/tools/"
			allLabel="查看游戏工具"
		/>

		<CategoryBrowse items={projects} />
		{latestPosts.length > 0 && <LatestPosts posts={latestPosts} />}

		<section class="about-strip" aria-labelledby="about-strip-title">
			<div>
				<p class="eyebrow">关于 CloudLight</p>
				<h2 id="about-strip-title">一个持续整理中的个人网站</h2>
				<p>这里的工具来自实际使用需求。项目页面负责把用途和用法说清楚，博客记录更完整的问题处理过程。</p>
			</div>
			<a class="button button-secondary" href="/about/">了解更多</a>
		</section>
	</main>
</BaseLayout>

<style>
	.home {
		width: min(var(--content-width), calc(100% - 2rem));
		max-width: none;
		padding: 0 0 clamp(5rem, 9vw, 8rem);
	}
	.about-strip {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		margin-top: var(--section-space);
		padding: clamp(1.75rem, 4vw, 2.75rem);
		background: linear-gradient(125deg, #1c2235, #242b43);
		border-radius: var(--radius-xlarge);
		box-shadow: var(--shadow-medium);
		color: #bfc8d9;
	}
	.about-strip > div { max-width: 46rem; }
	.about-strip h2 { color: #fff; }
	.about-strip p:last-child { margin: 0; }
	.about-strip .eyebrow { color: #aeb0ff; }
	.about-strip .button { flex: 0 0 auto; background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.2); color: #fff; }
	.about-strip .button:hover { background: #fff; color: var(--color-text); }
	@media (max-width: 760px) {
		.home { width: min(var(--content-width), calc(100% - 1.5rem)); }
		.about-strip { display: block; }
		.about-strip .button { margin-top: 1.25rem; }
	}
	@media (max-width: 420px) { .about-strip .button { width: 100%; } }
</style>
