---
import BaseLayout from './BaseLayout.astro';
import type { ProjectDetail } from '../data/project-details';

interface Props {
	project: ProjectDetail;
}

const { project } = Astro.props;
const { item } = project;
const downloadUrl = item.downloadUrl;

if (!downloadUrl) {
	throw new Error(`Missing download URL for project: ${project.slug}`);
}
---

<BaseLayout title={`${item.name} · CloudLight`} description={project.pageDescription}>
	<main class="project-detail">
		<nav class="breadcrumbs" aria-label="面包屑">
			<ol>
				<li><a href="/">首页</a></li>
				<li><a href="/projects/">项目</a></li>
				<li aria-current="page">{item.name}</li>
			</ol>
		</nav>

		<header class="project-hero">
			<div class="hero-content">
				<p class="eyebrow">{item.category}</p>
				<h1>{item.name}</h1>
				{item.englishName && <p class="english-name">{item.englishName}</p>}
				<p class="hero-summary">{item.summary}</p>
				<div class="project-meta" aria-label="项目状态与技术标签">
					<span class="status">{item.status}</span>
					{item.tags.map((tag) => <span>{tag}</span>)}
				</div>
				<div class="project-actions">
					<a
						class="button button-primary"
						href={downloadUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						{item.downloadLabel ?? 'GitHub 下载'}
						<span aria-hidden="true">↗</span>
						<span class="sr-only">（在新窗口打开）</span>
					</a>
					<a
						class="button button-secondary"
						href={item.repository}
						target="_blank"
						rel="noopener noreferrer"
					>
						查看 GitHub 仓库
						<span aria-hidden="true">↗</span>
						<span class="sr-only">（在新窗口打开）</span>
					</a>
				</div>
				{item.downloadNote && <p class="download-note">{item.downloadNote}</p>}
			</div>
			<div class="hero-mark" aria-hidden="true">
				<span>PROJECT</span>
				<strong>{project.slug.split('-').slice(0, 2).join(' / ')}</strong>
				<small>CloudLight</small>
			</div>
		</header>

		<section class="project-section reading-section" aria-labelledby="introduction-title">
			<p class="eyebrow">Overview</p>
			<h2 id="introduction-title">项目介绍</h2>
			<div class="prose">
				{project.introduction.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</section>

		<section class="project-section" aria-labelledby="use-cases-title">
			<p class="eyebrow">Use cases</p>
			<h2 id="use-cases-title">适用场景</h2>
			<div class="info-grid use-case-grid">
				{project.useCases.map((useCase) => (
					<article class="info-card">
						<h3>{useCase.title}</h3>
						<p>{useCase.description}</p>
					</article>
				))}
			</div>
		</section>

		<section class="project-section" aria-labelledby="features-title">
			<p class="eyebrow">Features</p>
			<h2 id="features-title">主要功能</h2>
			<div class="feature-groups">
				{project.featureGroups.map((group) => (
					<section class="feature-group" aria-labelledby={`${project.slug}-${group.title}`}>
						<div class="group-heading">
							<h3 id={`${project.slug}-${group.title}`}>{group.title}</h3>
							{group.description && <p>{group.description}</p>}
						</div>
						<div class="info-grid feature-grid">
							{group.items.map((feature) => (
								<article class="info-card">
									<h4>{feature.title}</h4>
									<p>{feature.description}</p>
								</article>
							))}
						</div>
					</section>
				))}
			</div>
		</section>

		<section class="project-section reading-section" aria-labelledby="steps-title">
			<p class="eyebrow">Guide</p>
			<h2 id="steps-title">使用方法</h2>
			<ol class="steps">
				{project.steps.map((step) => (
					<li>
						<div>
							<h3>{step.title}</h3>
							<p>{step.description}</p>
							{step.command && (
								<pre aria-label={`${step.title}命令示例`}><code>{step.command}</code></pre>
							)}
						</div>
					</li>
				))}
			</ol>
		</section>

		<section class="project-section reading-section" aria-labelledby="requirements-title">
			<p class="eyebrow">Requirements</p>
			<h2 id="requirements-title">系统与运行要求</h2>
			<dl class="requirements">
				{project.requirements.map((requirement) => (
					<div>
						<dt>{requirement.term}</dt>
						<dd>{requirement.description}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="project-section" aria-labelledby="technical-title">
			<p class="eyebrow">Technical</p>
			<h2 id="technical-title">技术信息</h2>
			<div class="info-grid technical-grid">
				{project.technicalDetails.map((detail) => (
					<article class="info-card">
						<h3>{detail.title}</h3>
						<p>{detail.description}</p>
					</article>
				))}
			</div>
		</section>

		<aside class="project-section notice" aria-labelledby="notice-title">
			<p class="eyebrow">Before you start</p>
			<h2 id="notice-title">注意事项</h2>
			<ul>
				{project.cautions.map((caution) => <li>{caution}</li>)}
			</ul>
		</aside>

		<section class="project-cta" aria-labelledby="download-title">
			<div>
				<p class="eyebrow">Download</p>
				<h2 id="download-title">获取项目</h2>
				<p>{item.downloadNote}</p>
			</div>
			<div class="project-actions">
				<a
					class="button button-primary"
					href={downloadUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
					{item.downloadLabel ?? 'GitHub 下载'}
					<span aria-hidden="true">↗</span>
					<span class="sr-only">（在新窗口打开）</span>
				</a>
				<a
					class="button button-secondary"
					href={item.repository}
					target="_blank"
					rel="noopener noreferrer"
				>
					查看源码
					<span aria-hidden="true">↗</span>
					<span class="sr-only">（在新窗口打开）</span>
				</a>
				<a class="text-link" href="/projects/">返回项目列表</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.project-detail {
		width: min(var(--content-width), calc(100% - 2rem));
		padding-top: clamp(2rem, 5vw, 3.75rem);
		padding-bottom: clamp(4rem, 8vw, 7rem);
	}
	.breadcrumbs {
		margin-bottom: 1.25rem;
		color: var(--color-text-muted);
		font-size: 0.82rem;
	}
	.breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.breadcrumbs li:not(:last-child)::after {
		margin-left: 0.35rem;
		color: #93a0b0;
		content: '/';
	}
	.breadcrumbs a {
		color: inherit;
		text-decoration: none;
	}
	.breadcrumbs a:hover {
		color: var(--color-accent-hover);
	}
	.project-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(13rem, 0.7fr);
		gap: clamp(2rem, 6vw, 4.5rem);
		align-items: center;
		padding: clamp(2rem, 6vw, 4.25rem);
		overflow: hidden;
		background:
			linear-gradient(135deg, rgba(231, 240, 251, 0.9), rgba(255, 255, 255, 0.96)),
			var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-medium);
	}
	.project-hero h1 {
		max-width: 17ch;
		margin-bottom: 0.35rem;
		font-size: clamp(2.1rem, 5.6vw, 4rem);
		overflow-wrap: anywhere;
	}
	.english-name {
		margin-bottom: 1rem;
		color: var(--color-accent-hover);
		font-family: Consolas, 'SFMono-Regular', monospace;
		font-size: clamp(0.9rem, 2vw, 1.05rem);
		font-weight: 700;
		overflow-wrap: anywhere;
	}
	.hero-summary {
		max-width: 42rem;
		margin-bottom: 1.4rem;
		color: var(--color-text-muted);
		font-size: clamp(1rem, 2vw, 1.08rem);
	}
	.project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1.5rem;
	}
	.project-meta span {
		padding: 0.24rem 0.58rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-text-muted);
		font-size: 0.72rem;
		font-weight: 700;
	}
	.project-meta .status {
		background: var(--color-success-soft);
		border-color: transparent;
		color: var(--color-success);
	}
	.project-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}
	.download-note {
		max-width: 42rem;
		margin: 0.85rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.8rem;
	}
	.hero-mark {
		display: flex;
		min-height: 14rem;
		padding: 1.4rem;
		flex-direction: column;
		justify-content: space-between;
		background: #18202b;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--radius-large);
		color: white;
		box-shadow: var(--shadow-medium);
		font-family: Consolas, 'SFMono-Regular', monospace;
	}
	.hero-mark span,
	.hero-mark small {
		color: #adc8eb;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.hero-mark strong {
		font-size: clamp(1.15rem, 3vw, 1.7rem);
		line-height: 1.25;
		overflow-wrap: anywhere;
		text-transform: uppercase;
	}
	.project-section {
		padding-top: var(--section-space);
		scroll-margin-top: 6rem;
	}
	.reading-section {
		max-width: 52rem;
		margin-right: auto;
		margin-left: auto;
	}
	.project-section > h2,
	.project-cta h2 {
		margin-bottom: 1.5rem;
	}
	.info-grid {
		display: grid;
		gap: 1rem;
	}
	.use-case-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.feature-grid,
	.technical-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.info-card {
		min-width: 0;
		padding: 1.35rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-medium);
		box-shadow: var(--shadow-small);
	}
	.info-card h3,
	.info-card h4 {
		margin-bottom: 0.45rem;
	}
	.info-card p,
	.group-heading p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}
	.feature-groups {
		display: grid;
		gap: 2.25rem;
	}
	.group-heading {
		max-width: 48rem;
		margin-bottom: 1rem;
	}
	.group-heading h3 {
		margin-bottom: 0.45rem;
	}
	.steps {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: project-step;
	}
	.steps li {
		display: grid;
		grid-template-columns: 2.6rem minmax(0, 1fr);
		gap: 1rem;
		padding: 1.2rem 0;
		border-bottom: 1px solid var(--color-border);
		counter-increment: project-step;
	}
	.steps li::before {
		display: inline-flex;
		width: 2.4rem;
		height: 2.4rem;
		align-items: center;
		justify-content: center;
		background: var(--color-accent-soft);
		border-radius: 999px;
		color: var(--color-accent-hover);
		content: counter(project-step, decimal-leading-zero);
		font-size: 0.72rem;
		font-weight: 700;
	}
	.steps h3 {
		margin: 0.1rem 0 0.35rem;
		font-size: 1.08rem;
	}
	.steps p {
		margin: 0;
		color: var(--color-text-muted);
	}
	.steps pre {
		margin: 1rem 0 0;
		background: #18202b;
		color: #eef4fb;
		font-size: 0.8rem;
		line-height: 1.65;
		white-space: pre;
	}
	.requirements {
		display: grid;
		margin: 0;
		border-top: 1px solid var(--color-border);
	}
	.requirements > div {
		display: grid;
		grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-border);
	}
	.requirements dt {
		font-weight: 700;
	}
	.requirements dd {
		margin: 0;
		color: var(--color-text-muted);
	}
	.notice {
		padding: clamp(1.5rem, 4vw, 2.25rem);
		margin-top: var(--section-space);
		background: #fff9ed;
		border: 1px solid #ead9b7;
		border-radius: var(--radius-large);
	}
	.notice.project-section {
		padding-top: clamp(1.5rem, 4vw, 2.25rem);
	}
	.notice .eyebrow {
		color: #815b19;
	}
	.notice h2 {
		margin-bottom: 1rem;
	}
	.notice ul {
		margin: 0;
		padding-left: 1.25rem;
	}
	.notice li + li {
		margin-top: 0.6rem;
	}
	.project-cta {
		display: flex;
		justify-content: space-between;
		gap: 2rem;
		align-items: center;
		padding: clamp(1.5rem, 5vw, 2.5rem);
		margin-top: var(--section-space);
		background: var(--color-accent-soft);
		border: 1px solid rgba(36, 93, 168, 0.2);
		border-radius: var(--radius-large);
	}
	.project-cta > div:first-child {
		max-width: 37rem;
	}
	.project-cta h2,
	.project-cta p {
		margin-bottom: 0.5rem;
	}
	.project-cta p:last-child {
		margin-bottom: 0;
		color: var(--color-text-muted);
	}
	.text-link {
		font-size: 0.86rem;
		font-weight: 700;
		text-decoration: none;
	}
	@media (max-width: 880px) {
		.project-hero {
			grid-template-columns: 1fr;
		}
		.hero-mark {
			min-height: 9rem;
		}
		.use-case-grid {
			grid-template-columns: 1fr;
		}
		.project-cta {
			display: block;
		}
		.project-cta .project-actions {
			margin-top: 1.25rem;
		}
	}
	@media (max-width: 720px) {
		.project-detail {
			width: min(var(--content-width), calc(100% - 1.5rem));
		}
		.project-hero {
			padding: 1.4rem;
		}
		.hero-mark {
			display: none;
		}
		.feature-grid,
		.technical-grid {
			grid-template-columns: 1fr;
		}
		.requirements > div {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
		.project-actions .button {
			width: 100%;
		}
		.project-cta .text-link {
			width: 100%;
			margin-top: 0.35rem;
			text-align: center;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.info-card:hover {
			transform: none;
		}
	}
</style>
