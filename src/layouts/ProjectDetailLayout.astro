---
import { Image } from 'astro:assets';
import {
	getCatalogCategories,
	kindLabels,
	statusLabels,
	type CatalogAction,
	type CatalogScreenshot,
} from '../data/catalog';
import type { ProjectDetail } from '../data/project-details';
import BaseLayout from './BaseLayout.astro';

interface Props { project: ProjectDetail; }

const { project } = Astro.props;
const { item } = project;
const categories = getCatalogCategories(item);
const screenshots: CatalogScreenshot[] = item.screenshots ?? (item.screenshot ? [{
	image: item.screenshot,
	alt: item.screenshotAlt ?? `${item.name}界面截图`,
	caption: item.screenshotCaption,
}] : []);
const heroScreenshot = screenshots[0];
const screenshotWidths = (width: number) => [...new Set([480, 720, 960, 1280, width])]
	.filter((candidate) => candidate <= width)
	.sort((a, b) => a - b);
const externalProps = (action: CatalogAction) =>
	action.external ? { target: '_blank' as const, rel: 'noopener noreferrer' } : {};
const sectionScreenshots = (indexes: number[]) => indexes
	.map((index) => screenshots[index])
	.filter((screenshot): screenshot is CatalogScreenshot => screenshot !== undefined);
const sections = project.sections;
---

<BaseLayout title={`${item.name} · CloudLight`} description={project.pageDescription} image={heroScreenshot?.image}>
	<main class="project-detail">
		<nav class="breadcrumbs" aria-label="面包屑">
			<a href="/">首页</a><span aria-hidden="true">/</span><a href="/projects/">项目</a><span aria-hidden="true">/</span><span aria-current="page">{item.name}</span>
		</nav>

		<header class:list={['project-hero', `accent-${item.accent}`, { 'no-screenshot': !heroScreenshot }]}>
			<div class="hero-copy">
				<p class="hero-kicker">
					{categories.map((category) => category.name).join(' · ')} · {kindLabels[item.kind]}
					<span class="status"><i aria-hidden="true"></i>{statusLabels[item.status]}</span>
				</p>
				<div class="project-title">
					{item.icon && <span class="project-icon" aria-hidden="true"><Image src={item.icon} alt="" widths={[72, 144]} sizes="72px" /></span>}
					<div><h1>{item.name}</h1>{item.englishName && <p>{item.englishName}</p>}</div>
				</div>
				<p class="hero-summary">{item.summary}</p>
				<ul class="capability-list" aria-label="主要能力">
					{item.capabilities.slice(0, 3).map((capability) => <li>{capability}</li>)}
				</ul>
				<div class="hero-actions">
					<a class="button button-primary primary-cta" href={item.primaryAction.href} {...externalProps(item.primaryAction)}>
						{item.primaryAction.label} <span aria-hidden="true">{item.primaryAction.external ? '↗' : '→'}</span>
						{item.primaryAction.external && <span class="sr-only">（在新窗口打开）</span>}
					</a>
					{item.secondaryAction && (
						<a class="button button-secondary" href={item.secondaryAction.href} {...externalProps(item.secondaryAction)}>
							{item.secondaryAction.label} <span aria-hidden="true">↗</span><span class="sr-only">（在新窗口打开）</span>
						</a>
					)}
				</div>
				<p class="cta-note">
					{item.ctaNote ?? (item.kind === 'desktop' ? '在 GitHub Releases 获取最新版本。' : item.kind === 'userscript' ? '安装前请在脚本管理器中核对匹配范围和权限。' : '打开在线工具即可使用。')}
				</p>
			</div>

			<div class="hero-preview">
				{heroScreenshot ? (
					<figure>
						<a href={heroScreenshot.image.src} target="_blank" rel="noopener noreferrer">
							<Image
								src={heroScreenshot.image}
								alt={heroScreenshot.alt}
								widths={screenshotWidths(heroScreenshot.image.width)}
								sizes="(max-width: 900px) calc(100vw - 3rem), min(48vw, 650px)"
							/>
							<span class="sr-only">（在新窗口打开原图）</span>
						</a>
						{heroScreenshot.caption && <figcaption>{heroScreenshot.caption}</figcaption>}
					</figure>
				) : (
					<div class:list={['script-preview', { desktop: item.kind === 'desktop' }]} aria-hidden="true">
						<div class="script-window"><span></span><span></span><span></span><small>{item.kind === 'desktop' ? 'Windows' : 'user.js'}</small></div>
						<div class="script-body">
							{item.icon ? <span class="preview-icon"><Image src={item.icon} alt="" widths={[96, 192]} sizes="96px" /></span> : <strong>{item.kind === 'desktop' ? '▣' : '//'}</strong>}
							<p>{item.kind === 'desktop' ? <>仓库暂未提供界面截图<br />请先查看使用要求</> : <>直接在目标网页中运行<br />由你开始和确认操作</>}</p>
						</div>
					</div>
				)}
			</div>
		</header>

		<div class="project-sections">
			{sections.map((section) => (
				<>
					{section.type === 'features' && (
						<section class="detail-section" id={section.id} aria-labelledby={`${section.id}-title`}>
							<header class="section-header">
								<h2 id={`${section.id}-title`}>{section.title}</h2>
								{section.intro?.map((paragraph) => <p>{paragraph}</p>)}
							</header>
							<div class:list={['feature-list', `layout-${section.layout ?? 'list'}`]}>
								{section.items.map((feature) => <article><h3>{feature.title}</h3><p>{feature.description}</p></article>)}
							</div>
						</section>
					)}

					{section.type === 'feature-groups' && (
						<section class="detail-section" id={section.id} aria-labelledby={`${section.id}-title`}>
							<header class="section-header">
								<h2 id={`${section.id}-title`}>{section.title}</h2>
								{section.intro?.map((paragraph) => <p>{paragraph}</p>)}
							</header>
							<div class="feature-groups">
								{section.groups.map((group) => (
									<section class="feature-group">
										<h3>{group.title}</h3>
										<div>{group.items.map((feature) => <article><h4>{feature.title}</h4><p>{feature.description}</p></article>)}</div>
									</section>
								))}
							</div>
						</section>
					)}

					{section.type === 'steps' && (
						<section class="detail-section split-section" id={section.id} aria-labelledby={`${section.id}-title`}>
							<header class="section-header">
								<h2 id={`${section.id}-title`}>{section.title}</h2>
								{section.intro?.map((paragraph) => <p>{paragraph}</p>)}
							</header>
							<ol class="steps">{section.items.map((step) => <li><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
						</section>
					)}

					{section.type === 'facts' && (
						<section class="detail-section split-section" id={section.id} aria-labelledby={`${section.id}-title`}>
							<header class="section-header">
								<h2 id={`${section.id}-title`}>{section.title}</h2>
								{section.intro?.map((paragraph) => <p>{paragraph}</p>)}
							</header>
							<dl class="facts">{section.items.map((fact) => <div><dt>{fact.term}</dt><dd>{fact.description}</dd></div>)}</dl>
						</section>
					)}

					{section.type === 'bullets' && (
						<section class:list={['detail-section', 'split-section', { warning: section.tone === 'warning' }]} id={section.id} aria-labelledby={`${section.id}-title`}>
							<header class="section-header">
								<h2 id={`${section.id}-title`}>{section.title}</h2>
								{section.intro?.map((paragraph) => <p>{paragraph}</p>)}
							</header>
							<ul class="bullet-list">{section.items.map((item) => <li>{item}</li>)}</ul>
						</section>
					)}

					{section.type === 'note' && (
						<aside class="important-note" id={section.id} aria-labelledby={`${section.id}-title`}>
							<div aria-hidden="true">!</div><div><h2 id={`${section.id}-title`}>{section.title}</h2><p>{section.description}</p></div>
						</aside>
					)}

					{section.type === 'screenshots' && (
						<section class="detail-section" id={section.id} aria-labelledby={`${section.id}-title`}>
							<header class="section-header">
								<h2 id={`${section.id}-title`}>{section.title}</h2>
								{section.intro?.map((paragraph) => <p>{paragraph}</p>)}
							</header>
							<div class="body-gallery">
								{sectionScreenshots(section.indexes).map((screenshot) => (
									<figure>
										<a href={screenshot.image.src} target="_blank" rel="noopener noreferrer">
											<Image src={screenshot.image} alt={screenshot.alt} widths={screenshotWidths(screenshot.image.width)} sizes="(max-width: 700px) calc(100vw - 3rem), min(44vw, 540px)" />
											<span class="sr-only">（在新窗口打开原图）</span>
										</a>
										{screenshot.caption && <figcaption>{screenshot.caption}</figcaption>}
									</figure>
								))}
							</div>
						</section>
					)}

					{section.type === 'links' && (
						<section class="detail-section links-section" id={section.id} aria-labelledby={`${section.id}-title`}>
							<h2 id={`${section.id}-title`}>{section.title}</h2>
							<div>{section.items.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span><span class="sr-only">（在新窗口打开）</span></a>)}</div>
						</section>
					)}
				</>
			))}
		</div>

		<footer class="project-footer"><a href="/projects/">← 返回项目列表</a></footer>
	</main>
</BaseLayout>

<style>
	.project-detail { width: min(var(--content-width), calc(100% - 2rem)); max-width: none; padding-top: 2rem; padding-bottom: clamp(4rem, 8vw, 6.5rem); }
	.breadcrumbs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.25rem; color: var(--color-text-soft); font-size: var(--font-size-xs); }
	.breadcrumbs a { color: inherit; text-decoration: none; }
	.breadcrumbs a:hover { color: var(--color-accent); }
	.project-hero {
		--detail-accent: var(--color-accent);
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(25rem, 1.08fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 4.5rem);
		padding: clamp(1.5rem, 4vw, 3.5rem);
		overflow: hidden;
		background: linear-gradient(135deg, color-mix(in srgb, var(--detail-accent) 9%, white), rgba(255, 255, 255, 0.96) 62%);
		border: 1px solid color-mix(in srgb, var(--detail-accent) 22%, var(--color-border));
		border-radius: var(--radius-xlarge);
		box-shadow: var(--shadow-medium);
	}
	.project-hero.accent-cyan { --detail-accent: #238f91; }
	.project-hero.accent-violet { --detail-accent: #7b55d9; }
	.project-hero.accent-amber { --detail-accent: #c47a20; }
	.project-hero.no-screenshot { grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.55fr); }
	.hero-copy { min-width: 0; }
	.hero-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; margin: 0 0 1.15rem; color: var(--color-text-soft); font-size: var(--font-size-xs); font-weight: 700; letter-spacing: 0.04em; }
	.hero-kicker .status { display: inline-flex; align-items: center; gap: 0.32rem; color: var(--color-success); }
	.hero-kicker i { width: 0.38rem; height: 0.38rem; background: currentColor; border-radius: 50%; }
	.project-title { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.15rem; }
	.project-title > div:last-child { min-width: 0; }
	.project-icon { display: grid; width: 4.5rem; height: 4.5rem; flex: 0 0 4.5rem; place-items: center; padding: 0.42rem; background: rgba(255, 255, 255, 0.86); border: 1px solid color-mix(in srgb, var(--detail-accent) 24%, var(--color-border)); border-radius: 1.1rem; box-shadow: var(--shadow-small); }
	.project-icon :global(img) { width: 100%; height: 100%; object-fit: contain; }
	h1 { margin: 0; font-size: var(--font-size-detail-title); overflow-wrap: anywhere; }
	.project-title p { margin: 0.3rem 0 0; color: var(--color-text-soft); font-size: var(--font-size-sm); line-height: 1.35; overflow-wrap: anywhere; }
	.hero-summary { max-width: 41rem; margin-bottom: 1.2rem; color: var(--color-text-muted); font-size: clamp(1rem, 1.8vw, 1.12rem); }
	.capability-list { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0 0 1.5rem; padding: 0; list-style: none; }
	.capability-list li { padding: 0.28rem 0.58rem; background: color-mix(in srgb, var(--detail-accent) 8%, white); border: 1px solid color-mix(in srgb, var(--detail-accent) 18%, var(--color-border)); border-radius: 0.5rem; color: color-mix(in srgb, var(--detail-accent) 72%, var(--color-text)); font-size: var(--font-size-xs); font-weight: 700; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
	.primary-cta { min-height: 3.4rem; padding-right: 1.3rem; padding-left: 1.3rem; background: var(--detail-accent); box-shadow: 0 12px 28px color-mix(in srgb, var(--detail-accent) 25%, transparent); font-size: 0.96rem; }
	.primary-cta:hover { background: color-mix(in srgb, var(--detail-accent) 82%, black); }
	.cta-note { margin: 0.8rem 0 0; color: var(--color-text-soft); font-size: var(--font-size-sm); }
	.hero-preview { min-width: 0; }
	.hero-preview figure, .body-gallery figure { margin: 0; }
	.hero-preview figure > a, .body-gallery figure > a { display: grid; place-items: center; padding: 0.45rem; background: rgba(255, 255, 255, 0.88); border: 1px solid var(--color-border); border-radius: 1.2rem; box-shadow: 0 24px 50px rgba(34, 43, 66, 0.16); }
	.hero-preview figure > a:hover, .body-gallery figure > a:hover { border-color: var(--detail-accent, var(--color-accent)); transform: translateY(-2px); }
	.hero-preview figure :global(img), .body-gallery figure :global(img) { display: block; width: auto; max-width: 100%; height: auto; max-height: 31rem; object-fit: contain; border-radius: 0.85rem; }
	.hero-preview figcaption, .body-gallery figcaption { margin-top: 0.7rem; color: var(--color-text-muted); font-size: var(--font-size-sm); line-height: 1.5; text-align: center; }
	.script-preview { overflow: hidden; background: #191f30; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: var(--radius-large); box-shadow: var(--shadow-medium); color: #fff; }
	.script-window { display: flex; align-items: center; gap: 0.4rem; padding: 0.75rem 0.9rem; background: rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
	.script-window > span { width: 0.5rem; height: 0.5rem; background: #626d83; border-radius: 50%; }
	.script-window small { margin-left: auto; color: #909bb0; font-family: Consolas, monospace; }
	.script-body { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.5rem; padding: 2rem; }
	.script-body strong { color: #d7b1ff; font-family: Consolas, monospace; font-size: 4rem; line-height: 1; }
	.preview-icon { display: grid; width: 6rem; height: 6rem; place-items: center; padding: 0.35rem; overflow: hidden; background: rgba(255, 255, 255, 0.08); border-radius: 1.25rem; }
	.preview-icon :global(img) { display: block; width: 100%; height: 100%; border-radius: 0.95rem; object-fit: contain; }
	.script-body p { margin: 0; color: #c4ccda; font-size: 1.15rem; line-height: 1.8; }
	.project-sections { width: min(68rem, 100%); margin: 0 auto; }
	.detail-section { margin-top: clamp(3.25rem, 6.5vw, 5.5rem); scroll-margin-top: 6rem; }
	.section-header { max-width: 47rem; margin-bottom: 1.5rem; }
	.section-header h2 { margin-bottom: 0.75rem; font-size: var(--font-size-h2); }
	.section-header p { margin: 0 0 0.65rem; color: var(--color-text-muted); font-size: 1rem; }
	.section-header p:last-child { margin-bottom: 0; }
	.split-section { display: grid; grid-template-columns: minmax(13rem, 0.62fr) minmax(0, 1.38fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
	.split-section > .section-header { margin: 0; }
	.feature-list { display: grid; }
	.feature-list article { min-width: 0; }
	.feature-list h3 { margin-bottom: 0.4rem; font-size: var(--font-size-h3); }
	.feature-list p { margin: 0; color: var(--color-text-muted); font-size: 0.9375rem; }
	.feature-list.layout-list { border-top: 1px solid var(--color-border); }
	.feature-list.layout-list article { display: grid; grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1fr); gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); }
	.feature-list.layout-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2.5rem; border-top: 1px solid var(--color-border); }
	.feature-list.layout-columns article { padding: 1.15rem 0; border-bottom: 1px solid var(--color-border); }
	.feature-list.layout-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; }
	.feature-list.layout-cards article { padding: 1.25rem; background: rgba(255, 255, 255, 0.7); border: 1px solid var(--color-border); border-radius: var(--radius-medium); }
	.feature-groups { display: grid; gap: 2.25rem; }
	.feature-group > h3 { margin-bottom: 0.9rem; font-size: var(--font-size-h3); }
	.feature-group > div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-border); }
	.feature-group article { min-width: 0; padding: 1rem 1.25rem 1rem 0; border-bottom: 1px solid var(--color-border); }
	.feature-group h4 { margin-bottom: 0.35rem; }
	.feature-group p { margin: 0; color: var(--color-text-muted); font-size: 0.9375rem; }
	.steps { margin: 0; padding: 0; list-style: none; counter-reset: step; }
	.steps li { display: grid; grid-template-columns: 2.55rem minmax(0, 1fr); gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); counter-increment: step; }
	.steps li:first-child { padding-top: 0; }
	.steps li::before { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; background: var(--color-accent-soft); border-radius: 0.72rem; color: var(--color-accent-hover); content: counter(step, decimal-leading-zero); font-size: var(--font-size-xs); font-weight: 700; }
	.steps h3 { margin: 0.12rem 0 0.3rem; font-size: var(--font-size-h3); }
	.steps p { margin: 0; color: var(--color-text-muted); font-size: 0.9375rem; }
	.facts { margin: 0; border-top: 1px solid var(--color-border); }
	.facts > div { display: grid; grid-template-columns: minmax(6.5rem, 0.3fr) minmax(0, 1fr); gap: 1.25rem; padding: 0.9rem 0; border-bottom: 1px solid var(--color-border); }
	.facts dt { font-weight: 700; }
	.facts dd { margin: 0; color: var(--color-text-muted); }
	.bullet-list { margin: 0; padding: 0; list-style: none; }
	.bullet-list li { position: relative; padding: 0 0 0.85rem 1.2rem; color: var(--color-text-muted); }
	.bullet-list li::before { position: absolute; top: 0.65em; left: 0; width: 0.42rem; height: 0.42rem; background: var(--color-accent); border-radius: 50%; content: ''; }
	.warning .bullet-list li::before { background: #d39545; }
	.important-note { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; margin-top: clamp(3rem, 6vw, 4.75rem); padding: 1.25rem 1.35rem; background: var(--color-warning-soft); border: 1px solid #efd6b0; border-radius: var(--radius-large); }
	.important-note > div:first-child { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; background: #fff; border-radius: 0.7rem; color: var(--color-warning); font-weight: 700; }
	.important-note h2 { margin-bottom: 0.3rem; font-size: 1.18rem; }
	.important-note p { margin: 0; color: #77552e; font-size: 0.9375rem; }
	.body-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }
	.body-gallery figure:only-child { grid-column: 1 / -1; width: min(48rem, 100%); }
	.links-section { padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
	.links-section h2 { margin-bottom: 0.8rem; font-size: 1.15rem; }
	.links-section > div { display: flex; flex-wrap: wrap; gap: 0.55rem 1.25rem; }
	.links-section a { font-size: var(--font-size-sm); font-weight: 700; text-decoration: none; }
	.project-footer { width: min(68rem, 100%); margin: clamp(3.25rem, 6vw, 5rem) auto 0; padding-top: 1.1rem; border-top: 1px solid var(--color-border); }
	.project-footer a { color: var(--color-text-muted); font-size: var(--font-size-sm); font-weight: 700; text-decoration: none; }
	.project-footer a:hover { color: var(--color-accent); }
	@media (max-width: 980px) {
		.project-hero, .project-hero.no-screenshot { grid-template-columns: 1fr; }
		.hero-preview { width: 100%; }
		.feature-list.layout-cards, .feature-group > div { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.split-section { grid-template-columns: 1fr; gap: 1.35rem; }
	}
	@media (max-width: 700px) {
		.project-detail { width: min(var(--content-width), calc(100% - 1.5rem)); padding-top: 1.25rem; }
		.project-hero { padding: 1.25rem; border-radius: var(--radius-large); }
		.project-title { align-items: flex-start; }
		.project-icon { width: 3.8rem; height: 3.8rem; flex-basis: 3.8rem; }
		h1 { font-size: clamp(1.875rem, 8.5vw, 2.25rem); }
		.hero-actions .button { width: 100%; }
		.hero-preview figure > a, .body-gallery figure > a { padding: 0.3rem; border-radius: 1rem; }
		.detail-section { margin-top: 3.5rem; }
		.feature-list.layout-columns, .feature-list.layout-cards, .feature-group > div, .body-gallery { grid-template-columns: 1fr; }
		.feature-list.layout-list article { grid-template-columns: 1fr; gap: 0.3rem; }
		.facts > div { grid-template-columns: 1fr; gap: 0.2rem; }
	}
</style>
