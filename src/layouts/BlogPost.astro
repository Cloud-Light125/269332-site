---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	author: {
		'@type': 'Person',
		name: SITE_TITLE,
		url: new URL('/', Astro.site),
	},
	url: canonicalURL,
	mainEntityOfPage: canonicalURL,
	...(heroImage ? { image: new URL(heroImage.src, Astro.site) } : {}),
};
---

<BaseLayout title={`${title} · ${SITE_TITLE}`} description={description} image={heroImage} type="article">
	<script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
	<main class="post-main">
		<article>
			<header class="post-header">
				<nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/blog/">博客</a></nav>
				<div class="post-meta"><span><FormattedDate date={pubDate} /></span>{updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}</div>
				<h1>{title}</h1>
				<p class="description">{description}</p>
				{tags.length > 0 && <ul class="post-tags" aria-label="文章标签">{tags.map((tag) => <li>{tag}</li>)}</ul>}
			</header>

			{heroImage && <figure class="hero-image"><Image src={heroImage} alt={`${title}文章配图`} widths={[720, 1080, 1440]} sizes="(max-width: 760px) calc(100vw - 1.5rem), min(1080px, calc(100vw - 2rem))" /><figcaption class="sr-only">{title}文章配图</figcaption></figure>}

			<div class="article-body"><slot /></div>
		</article>
	</main>
</BaseLayout>

<style>
	.post-main { width: min(1080px, calc(100% - 2rem)); max-width: none; padding-top: clamp(2.5rem, 6vw, 5rem); }
	.post-header { width: min(820px, 100%); margin: 0 auto clamp(2rem, 5vw, 3.5rem); text-align: center; }
	.breadcrumbs { display: flex; justify-content: center; gap: 0.45rem; margin-bottom: 2rem; color: var(--color-text-soft); font-size: var(--font-size-xs); }
	.breadcrumbs a { color: inherit; text-decoration: none; }
	.post-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.45rem 1rem; margin-bottom: 0.85rem; color: var(--color-text-soft); font-size: var(--font-size-xs); }
	.post-header h1 { margin-bottom: 1rem; font-size: var(--font-size-page-title); }
	.description { max-width: 43rem; margin: 0 auto; color: var(--color-text-muted); font-size: clamp(1.02rem, 2vw, 1.16rem); }
	.post-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem; margin: 1.25rem 0 0; padding: 0; list-style: none; }
	.post-tags li { padding: 0.22rem 0.52rem; background: var(--color-accent-soft); border-radius: 99px; color: var(--color-accent-hover); font-size: var(--font-size-xs); font-weight: 700; }
	.hero-image { margin: 0 0 clamp(3rem, 7vw, 5rem); }
	.hero-image :global(img) { display: block; width: 100%; max-height: 36rem; object-fit: cover; border: 1px solid var(--color-border); border-radius: var(--radius-xlarge); box-shadow: var(--shadow-medium); }
	.article-body { width: min(var(--reading-width), 100%); margin: 0 auto; color: #303a4d; font-size: 1.02rem; }
	.article-body :global(p) { margin-bottom: 1.55rem; }
	.article-body :global(h2) { margin-top: 3.25rem; margin-bottom: 1rem; font-size: var(--font-size-h2); }
	.article-body :global(h3) { margin-top: 2.3rem; margin-bottom: 0.8rem; }
	.article-body :global(h4) { margin-top: 1.8rem; }
	.article-body :global(ul), .article-body :global(ol) { margin: 0 0 1.6rem; padding-left: 1.4rem; }
	.article-body :global(li + li) { margin-top: 0.45rem; }
	.article-body :global(a) { font-weight: 600; }
	.article-body :global(img) { display: block; width: auto; max-width: 100%; margin: 2rem auto; border: 1px solid var(--color-border); border-radius: var(--radius-medium); box-shadow: var(--shadow-small); }
	.article-body :global(table) { display: table; margin: 2rem 0; font-size: 0.9rem; }
	.article-body :global(th), .article-body :global(td) { padding: 0.65rem 0.75rem; border: 1px solid var(--color-border); text-align: left; }
	.article-body :global(th) { background: var(--color-surface-muted); }
	.article-body :global(blockquote p:last-child) { margin-bottom: 0; }
	@media (max-width: 760px) {
		.post-main { width: min(1080px, calc(100% - 1.5rem)); }
		.post-header { text-align: left; }
		.breadcrumbs, .post-meta, .post-tags { justify-content: flex-start; }
		.hero-image :global(img) { border-radius: var(--radius-large); }
		.article-body { font-size: 1rem; }
		.article-body :global(table) { display: block; overflow-x: auto; }
	}
</style>
